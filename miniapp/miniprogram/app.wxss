page {
  background-color: #f5f5f5;
  color: #333333;
  font-size: 28rpx;
  box-sizing: border-box;
}

.container {
  padding: 24rpx;
}

.card {
  background-color: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.muted {
  color: #999999;
  font-size: 24rpx;
}

.empty {
  text-align: center;
  color: #999999;
  padding: 80rpx 0;
  font-size: 26rpx;
}

.btn-primary {
  background-color: #1677ff;
  color: #ffffff;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
}

.badge-online {
  background-color: #e6f7e9;
  color: #17a34a;
}

.badge-offline {
  background-color: #f5f5f5;
  color: #999999;
}

.badge-pending {
  background-color: #fff7e6;
  color: #d48806;
}

.badge-acked {
  background-color: #e6f7e9;
  color: #17a34a;
}

.badge-sent {
  background-color: #e6f0ff;
  color: #1677ff;
}

.badge-failed {
  background-color: #fff1f0;
  color: #cf1322;
}

.tabs {
  display: flex;
  background-color: #ffffff;
  border-bottom: 1rpx solid #eeeeee;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 26rpx;
  color: #666666;
}

.tab-item-active {
  color: #1677ff;
  font-weight: 600;
  border-bottom: 4rpx solid #1677ff;
}

.field {
  margin-bottom: 20rpx;
}

.field-label {
  font-size: 26rpx;
  color: #666666;
  margin-bottom: 8rpx;
  display: block;
}

.field-input {
  background-color: #f7f7f7;
  border-radius: 8rpx;
  padding: 16rpx;
  font-size: 28rpx;
}
