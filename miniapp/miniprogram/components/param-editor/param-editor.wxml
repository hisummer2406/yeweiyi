<!-- 参数修正 / 储罐设置 编辑表单（Issue #43），见 param-editor.ts。对象（设备、罐）由使用方的信息栏给出。 -->
<view class="pe">
  <view wx:if="{{state === 'loading'}}" class="muted pe-note">{{text.loading}}</view>

  <view wx:if="{{state === 'error'}}" class="card banner-warning pe-banner">
    <text class="text-warning">{{text.loadFailed}}</text>
    <button class="btn-primary" size="mini" bindtap="onRetry" style="margin-top:16rpx;">{{text.retry}}</button>
  </view>

  <block wx:if="{{state === 'ok' || state === 'none'}}">
    <!-- 本次下发的结果：只显示在它所属的罐上 -->
    <view wx:if="{{result}}" class="card pe-result pe-result-{{result.tone}}">
      <view class="pe-result-title">{{text.resultTitle}}</view>
      <view>{{result.message}}</view>
      <view wx:if="{{result.error}}" class="pe-result-error">{{text.reasonFromDevice}}{{result.error}}</view>
      <view class="pe-link" bindtap="onViewLog">{{text.viewLog}}</view>
    </view>

    <view wx:if="{{draftNote}}" class="card banner-warning pe-banner pe-draft">
      <text class="text-warning pe-draft-text">{{draftNote}}</text>
      <button class="btn-primary" size="mini" bindtap="onDiscard">{{text.discard}}</button>
    </view>
    <view wx:if="{{moved}}" class="card banner-warning pe-banner">
      <text class="text-warning">{{text.movedBanner}}</text>
    </view>

    <view class="fc pe-card">
      <view class="pe-head">
        <text class="pe-head-title">{{text.reportedTitle}}</text>
        <text class="muted pe-head-time">{{reportedText}}</text>
      </view>
      <view wx:if="{{refreshFailed}}" class="pe-note text-warning">{{text.refreshFailed}}</view>

      <view wx:for="{{rows}}" wx:key="key" class="pe-row {{item.changed ? 'pe-row-changed' : ''}}">
        <view class="fr pe-fr">
          <text class="fl pe-fl">{{item.label}}</text>
          <view class="fv"></view>
          <view
            wx:if="{{item.signed && !readOnly}}"
            class="pe-sign"
            data-key="{{item.key}}"
            bindtap="onToggleSign"
            aria-role="button"
            aria-label="{{text.toggleSign}}"
          >±</view>
          <!-- 全部数值字段用支持小数点的数字键盘（#56）；负号不进输入框，由 ± 控制并显示在这里 -->
          <text wx:if="{{item.signed && !readOnly && item.neg}}" class="pe-neg">−</text>
          <input
            wx:if="{{!readOnly}}"
            class="fi pe-fi {{item.signed ? 'pe-fi-signed' : ''}}"
            type="digit"
            placeholder="{{text.unreported}}"
            placeholder-class="fv-ph"
            value="{{item.mag}}"
            data-key="{{item.key}}"
            data-signed="{{item.signed}}"
            bindinput="onInput"
          />
          <text wx:else class="pe-fi {{item.value ? '' : 'fv-ph'}}">{{item.value || text.unreported}}</text>
          <text class="fu pe-fu">{{item.unit}}</text>
        </view>
        <view wx:if="{{item.note}}" class="pe-row-note {{item.warn ? 'text-warning' : ''}}">{{item.note}}</view>
      </view>

      <block wx:if="{{isTank}}">
        <!-- 介质：管理员从可选介质中选（云端换算编号）；员工或选项读不到时只读 -->
        <view class="pe-row {{mediumIdx >= 0 ? 'pe-row-changed' : ''}}">
          <view class="fr pe-fr">
            <text class="fl pe-fl">{{text.medium}}</text>
            <view class="fv"></view>
            <picker wx:if="{{!readOnly && mediumEditable}}" range="{{mediumNames}}" value="{{mediumIdx < 0 ? 0 : mediumIdx}}" bindchange="onMediumPick">
              <text class="pe-ro pe-pick">{{mediumIdx >= 0 ? mediumNames[mediumIdx] : (medium || text.unreported)}} ›</text>
            </picker>
            <text wx:else class="pe-ro">{{medium || text.unreported}}</text>
          </view>
          <view wx:if="{{mediumIdx >= 0}}" class="pe-row-note">{{medium || text.unreported}} → {{mediumNames[mediumIdx]}}</view>
          <view wx:if="{{!readOnly && mediumNote}}" class="pe-row-note text-warning">{{mediumNote}}</view>
        </view>
        <!-- 颜色：20 色色板，再点一次取消；固件不支持时只读 -->
        <view class="pe-row {{colorSel >= 0 ? 'pe-row-changed' : ''}}">
          <view class="fr pe-fr">
            <text class="fl pe-fl">{{text.color}}</text>
            <view class="fv"></view>
            <view wx:if="{{colorNow}}" class="pe-swatch" style="background:{{colorNow}};"></view>
            <text class="pe-ro">{{colorNow || text.unreported}}{{colorNonStandard ? text.colorNonStandard : ''}}</text>
          </view>
          <view wx:if="{{!readOnly && colorEditable}}" class="pe-palette">
            <view
              wx:for="{{colors}}"
              wx:key="color"
              class="pe-swatch pe-swatch-pick {{colorSel === item.color ? 'pe-swatch-on' : ''}}"
              style="background:{{item.css}};"
              data-color="{{item.color}}"
              bindtap="onColorPick"
              aria-role="radio"
              aria-label="{{text.color}} {{item.css}}"
            ></view>
          </view>
          <view wx:if="{{!readOnly && colorNote}}" class="pe-row-note">{{colorNote}}</view>
        </view>
        <!-- 罐高、低温报警：固件不支持远程修改（#65）时只读 -->
        <block wx:if="{{roRows.length}}">
          <view class="pe-sub">{{text.readonlyTitle}}</view>
          <view wx:for="{{roRows}}" wx:key="key" class="fr pe-fr">
            <text class="fl pe-fl">{{item.label}}</text>
            <view class="fv"></view>
            <text class="pe-ro">{{item.value}}</text>
            <text class="fu pe-fu">{{item.unit}}</text>
          </view>
          <view wx:if="{{heightTempNote}}" class="pe-row-note">{{heightTempNote}}</view>
        </block>
      </block>
    </view>

    <block wx:if="{{!readOnly}}">
      <view class="fc pe-card">
        <view class="fr pe-fr">
          <text class="fl pe-fl">{{text.reason}}</text>
          <input class="pe-reason" type="text" maxlength="200" placeholder="{{text.reasonPlaceholder}}" placeholder-class="fv-ph" value="{{reason}}" bindinput="onReasonInput" />
        </view>
      </view>
      <view class="muted pe-note">{{changedCount > 0 ? text.autoSaved : text.noChange}}</view>
      <view wx:if="{{sendBlock}}" class="muted pe-note text-warning">{{sendBlock}}</view>
      <view class="pe-actions">
        <button class="pill pill-deep pe-send" bindtap="onSend" disabled="{{sending || !canSend || changedCount === 0}}" loading="{{sending}}">{{text.send}}</button>
      </view>
    </block>
    <view wx:else class="muted pe-note">{{text.readOnly}}</view>
  </block>
</view>
