<!-- 设计稿「首页-设置05」。账号行是设计稿没有的（退出登录需要入口），放在菜单上方单独一块。
     各入口暂未接云端的原因在点击时用提示说明（见 more.ts），不写在行内。 -->
<view class="menu-list" style="margin-bottom:20rpx;">
  <view class="menu-row" bindtap="onAccountTap">
    <image class="avatar" style="margin-right:19rpx;" src="/assets/icons/avatar-logo.png" mode="aspectFit" />
    <view class="menu-title">
      <text>{{account || '--'}}</text>
      <view class="muted" style="margin-top:4rpx;">{{roleLabel || '--'}}</view>
    </view>
    <image class="menu-chevron" src="/assets/icons/chevron-right.png" mode="aspectFit" />
  </view>
</view>

<view class="menu-list">
  <view
    wx:for="{{items}}"
    wx:key="title"
    class="menu-row"
    bindtap="onItemTap"
    data-reason="{{item.reason}}"
    data-page="{{item.page}}"
  >
    <image class="menu-icon" src="/assets/icons/{{item.icon}}.png" mode="aspectFit" />
    <text class="menu-title">{{item.title}}</text>
    <image class="menu-chevron" src="/assets/icons/chevron-right.png" mode="aspectFit" />
  </view>
</view>
