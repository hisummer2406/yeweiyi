/* 数值取自设计稿「记录设置20」「记录设置-弹窗21」PNG：
   清空标签 92×46 #E4614F；库存生成时间的值 x=322；弹窗 618 宽、顶 524（页面区内 343）、圆角约 12，
   图标 34、标题 30rpx，正文 27rpx，按钮 156×60 间距 71、文字 22rpx。 */
.rs-chip {
  position: relative;
  top: 2rpx;
  width: 94rpx;
  height: 47rpx;
  line-height: 47rpx;
  text-align: center;
  border-radius: 24rpx;
  font-size: var(--font-meta);
  color: #ffffff;
  background-color: #e4614f;
}

.rs-interval-label {
  width: 263rpx;
  flex-shrink: 0;
}

.rs-interval {
  width: 50rpx;
  height: 60rpx;
  font-size: var(--font-body);
  color: #131313;
}

.rs-ph {
  color: #919191;
}

.rs-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 100;
  background-color: rgba(0, 0, 0, 0.15);
}

.rs-dialog {
  position: absolute;
  left: 66rpx;
  top: 343rpx;
  box-sizing: border-box;
  width: 618rpx;
  min-height: 263rpx;
  padding-bottom: 28rpx;
  background-color: #ffffff;
  border-radius: 12rpx;
}

.rs-dialog-head {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 42rpx;
  margin-top: 35rpx;
}

.rs-dialog-icon {
  width: 42rpx;
  height: 42rpx;
  line-height: 42rpx;
  margin-right: 18rpx;
  text-align: center;
  border-radius: 50%;
  font-size: var(--font-body);
  font-weight: 700;
  color: #ffffff;
  background-color: #ff8a00;
}

.rs-dialog-title {
  font-size: var(--font-title);
  color: #131313;
}

.rs-dialog-msg {
  padding: 0 24rpx;
  margin-top: 25rpx;
  line-height: 46rpx;
  text-align: center;
  font-size: var(--font-body);
  color: #131313;
}

.rs-dialog-btns {
  display: flex;
  justify-content: center;
  margin-top: 41rpx;
}

.rs-dialog-btn {
  width: 156rpx;
  height: 60rpx;
  line-height: 60rpx;
  text-align: center;
  border-radius: 30rpx;
  font-size: var(--font-body);
}

.rs-dialog-cancel {
  margin-right: 71rpx;
  color: #131313;
  background-color: #f5f6f8;
}

.rs-dialog-ok {
  color: #ffffff;
  background-color: #0066a2;
}
