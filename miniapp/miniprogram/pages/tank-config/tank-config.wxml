<!-- 设计稿「储罐设置」（miniapp#18，#6）：本机草稿 + 设备当前回报分开显示；管理员在设备开放时可下发。
     编辑对象：首页当前油站 → 其唯一设备 → 当前账号可见的罐。 -->
<view class="tc-page">
  <view class="card banner-warning tc-banner">
    <text class="text-warning">{{text.draftNote}}</text>
  </view>

  <view wx:if="{{state !== 'ok' && state !== 'loading'}}" class="card banner-warning tc-banner">
    <text class="text-warning">{{notice}}</text>
    <button wx:if="{{state === 'no-station'}}" class="btn-primary" size="mini" bindtap="onGoHome" style="margin-top:16rpx;">{{text.goHome}}</button>
    <button wx:if="{{state === 'error'}}" class="btn-primary" size="mini" bindtap="onRetry" style="margin-top:16rpx;">{{text.retry}}</button>
  </view>

  <block wx:if="{{state === 'ok'}}">
    <!-- 编辑前先确认对象：油站、设备、罐号 -->
    <view class="fc" style="margin-top:18rpx;padding:19rpx 0 19rpx;">
      <view class="fr fr-b">
        <text class="fl">{{text.station}}</text>
        <text class="fv">{{stationName}}</text>
      </view>
      <view class="fr fr-b">
        <text class="fl">{{text.device}}</text>
        <text class="fv">{{device}}</text>
      </view>
      <view class="fr fr-b" id="row-tank" data-pick="tank" bindtap="onOpenPicker">
        <text class="fl">{{form.tankNo}}</text>
        <text class="fv">{{tankOptions[tankIndex]}}</text>
        <image class="fc-chevron" src="/assets/icons/chevron-right.png" mode="aspectFit" />
      </view>
      <view class="muted tc-saved">{{savedText}}</view>
    </view>

    <!-- 设备当前回报：只读，来自云端镜像；不是草稿 -->
    <view class="fc" style="margin-top:18rpx;padding:19rpx 0 19rpx;">
      <view class="fr fr-b">
        <text class="fl">{{text.deviceTitle}}</text>
        <button wx:if="{{mirrorState === 'ok'}}" class="btn-primary" size="mini" bindtap="onImport">{{text.import}}</button>
      </view>
      <view wx:if="{{mirrorState === 'loading'}}" class="muted tc-saved">{{text.deviceLoading}}</view>
      <view wx:if="{{mirrorState === 'none'}}" class="muted tc-saved">{{text.deviceNotReported}}</view>
      <view wx:if="{{mirrorState === 'error'}}" class="muted tc-saved">{{text.deviceLoadFailed}}</view>
      <block wx:if="{{mirrorState === 'ok'}}">
        <view class="fr fr-b" wx:for="{{mirrorRows}}" wx:key="key">
          <text class="fl">{{item.label}}</text>
          <text class="fv">{{item.value}}</text>
        </view>
        <view class="muted tc-saved">{{mirrorTime}}</view>
      </block>
    </view>

    <view wx:if="{{sendHint}}" class="card banner-warning tc-banner">
      <text class="text-warning">{{sendHint}}</text>
    </view>

    <view class="fc" style="margin-top:18rpx;padding:19rpx 0 25rpx;">
      <view class="fr fr-b" id="row-color" data-pick="color" bindtap="onOpenPicker">
        <text class="fl">{{text.color}}</text>
        <view class="fv {{colorIndex < 0 ? 'fv-ph' : ''}}">
          <text wx:if="{{colorIndex < 0}}">{{text.unset}}</text>
          <view wx:else class="tc-color-dot" style="background-color:{{colorOptions[colorIndex]}};"></view>
        </view>
        <image class="fc-chevron" src="/assets/icons/chevron-right.png" mode="aspectFit" />
      </view>
      <view class="fr fr-b">
        <text class="fl">{{text.medium}}</text>
        <text class="fv">{{medium}}</text>
      </view>
      <view class="muted tc-saved">{{text.mediumByPlatform}}</view>
      <!-- 左标签 / 中输入 / 右固定单位。占位写「未设置」，与已填写的 0 区分 -->
      <view class="fr fr-b" wx:for="{{fields}}" wx:key="key">
        <text class="fl">{{item.label}}</text>
        <input
          class="fi"
          type="{{item.signed ? 'text' : 'digit'}}"
          placeholder="{{text.unset}}"
          placeholder-class="fv-ph"
          value="{{item.value}}"
          data-key="{{item.key}}"
          bindinput="onFieldInput"
        />
        <text class="fu">{{item.unit}}</text>
      </view>
      <!-- 下发原因（二次确认必填），只给可下发的管理员 -->
      <view wx:if="{{canSend}}" class="fr fr-b">
        <text class="fl">{{text.reason}}</text>
        <input class="fi-text" type="text" maxlength="200" placeholder="{{text.reasonPlaceholder}}" placeholder-class="fv-ph" value="{{reason}}" bindinput="onReasonInput" />
      </view>
    </view>
    <view wx:if="{{canSend}}" class="muted tc-saved">{{text.sendNote}}</view>
  </block>
</view>

<!-- 底部按钮固定在安全区之上，长表单滚动时不遮挡最后一项（.tc-page 留出底部空间） -->
<view wx:if="{{state === 'ok'}}" class="tc-actions">
  <view class="pill-row">
    <button class="pill pill-lite" bindtap="onReset">{{text.reset}}</button>
    <button class="pill pill-main" bindtap="onSave">{{text.saveDraft}}</button>
  </view>
  <view wx:if="{{canSend}}" class="pill-row" style="margin-top:16rpx;">
    <button class="pill pill-deep" bindtap="onSend" disabled="{{sending}}" loading="{{sending}}">{{text.send}}</button>
  </view>
</view>

<grid-picker show="{{gridShow}}" top="{{pickerTop}}" options="{{tankOptions}}" value="{{tankIndex}}" bind:pick="onPickGrid" bind:close="onClosePicker" />
<side-picker show="{{sideShow}}" kind="swatches" top="{{pickerTop}}" options="{{colorOptions}}" value="{{colorIndex}}" bind:pick="onPickSide" bind:close="onClosePicker" />
