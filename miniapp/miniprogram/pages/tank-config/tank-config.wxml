<!-- 设置页的参数入口（#43）：与罐详情页签共用 param-editor。对象：首页当前油站 → 其唯一设备 → 可见罐。 -->
<view wx:if="{{state !== 'ok' && state !== 'loading'}}" class="card banner-warning pp-banner">
  <text class="text-warning">{{notice}}</text>
  <button wx:if="{{state === 'no-station'}}" class="btn-primary" size="mini" bindtap="onGoHome" style="margin-top:16rpx;">{{text.goHome}}</button>
  <button wx:if="{{state === 'error'}}" class="btn-primary" size="mini" bindtap="onRetry" style="margin-top:16rpx;">{{text.retry}}</button>
</view>

<block wx:if="{{state === 'ok'}}">
  <view class="fc" style="padding:8rpx 0;">
    <view class="fr">
      <text class="fl">{{text.target}}</text>
      <text class="pp-text">{{stationName}} · {{device}}</text>
    </view>
    <view class="fr" id="row-tank" bindtap="onOpenTank">
      <text class="fl">{{form.tankNo}}</text>
      <text class="fv {{tankIndex < 0 ? 'fv-ph' : ''}}" style="text-align:right;">{{tankIndex < 0 ? text.pickTank : tankOptions[tankIndex]}}</text>
      <image class="fc-chevron" src="/assets/icons/chevron-right.png" mode="aspectFit" />
    </view>
  </view>
  <view wx:if="{{tank < 0}}" class="muted pp-note">{{text.pickTankHint}}</view>
  <param-editor wx:else id="editor" kind="{{kind}}" device="{{device}}" tank="{{tank}}" station="{{station}}" active="{{true}}" />
</block>

<grid-picker show="{{pickerShow}}" top="{{pickerTop}}" options="{{tankOptions}}" value="{{tankIndex}}" bind:pick="onPickTank" bind:close="onClosePicker" />
