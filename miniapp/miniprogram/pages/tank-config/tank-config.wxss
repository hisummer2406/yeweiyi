/* 设置页参数入口（#43）：对象信息栏；表单样式在 components/param-editor。 */
.pp-banner {
  margin: 16rpx 20rpx 0;
}

/* 长文本值（油站 · 设备编号）：单行省略，不撑高行 */
.pp-text {
  flex: 1;
  min-width: 0;
  text-align: right;
  font-size: var(--font-label);
  color: #131313;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.pp-note {
  padding: 24rpx 51rpx;
}
