<view class="container">
  <view class="card">
    <view class="list-row" style="border-bottom:none;padding-top:8rpx;">
      <image class="avatar" src="/assets/icons/avatar-logo.png" mode="aspectFit" />
      <view class="list-row-body">
        <text>{{username || '--'}}</text>
        <view class="muted" style="margin-top:4rpx;">{{roleLabel || '--'}}</view>
      </view>
    </view>
  </view>

  <button class="btn-secondary" bindtap="onLogout">退出登录</button>
</view>
