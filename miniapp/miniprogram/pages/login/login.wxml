<view class="center-page">
  <image class="brand-logo" src="/assets/illustrations/brand-mark.png" mode="aspectFit" />
  <view class="brand-title">{{text.title}}</view>
  <view class="brand-subtitle">{{text.subtitle}}</view>

  <view class="card center-card">
    <!-- WeChat sign-in exists only in the mini-program (utils/platform.ts); the app has the password form alone. -->
    <view class="mode-tabs" wx:if="{{wechatLogin}}">
      <view class="mode-tab {{mode === 'password' ? 'active' : ''}}" data-mode="password" bindtap="onSwitchMode">{{text.tabPassword}}</view>
      <view class="mode-tab {{mode === 'wechat' ? 'active' : ''}}" data-mode="wechat" bindtap="onSwitchMode">{{text.tabWechat}}</view>
    </view>

    <block wx:if="{{wechatLogin && mode === 'wechat'}}">
      <block wx:if="{{stage === 'restoring'}}">
        <view class="muted" style="text-align:center;padding:24rpx 0;">{{text.restoring}}</view>
      </block>
      <block wx:elif="{{stage === 'needPhone'}}">
        <view class="muted" style="text-align:center;margin-bottom:16rpx;">{{text.firstTime}}</view>
        <button class="btn-primary" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{busy}}">
          {{text.phoneButton}}
        </button>
      </block>
      <block wx:else>
        <button class="btn-primary" bindtap="onWechatLogin" loading="{{busy}}">{{text.wechatButton}}</button>
      </block>
    </block>

    <block wx:else>
      <view class="field">
        <text class="field-label">{{text.accountLabel}}</text>
        <input
          class="field-input"
          type="text"
          maxlength="64"
          placeholder="{{text.accountPlaceholder}}"
          value="{{account}}"
          bindinput="onAccountInput"
        />
      </view>
      <view class="field">
        <text class="field-label">{{text.passwordLabel}}</text>
        <input
          class="field-input"
          password
          placeholder="{{text.passwordPlaceholder}}"
          value="{{password}}"
          bindinput="onPasswordInput"
          bindconfirm="onPasswordLogin"
        />
      </view>
      <button class="btn-primary" bindtap="onPasswordLogin" loading="{{busy}}">{{text.submit}}</button>
      <view wx:if="{{wechatLogin}}" class="muted" style="margin-top:16rpx;text-align:center;">{{text.staffHint}}</view>
      <view class="muted" style="margin-top:16rpx;text-align:center;">{{text.passwordHint}}</view>
    </block>

    <view wx:if="{{errorMsg}}" class="muted text-danger" style="margin-top:16rpx;text-align:center;">{{errorMsg}}</view>
  </view>

  <view class="lang-entry" bindtap="onLanguageTap">{{langLabel}}: {{langName}} ›</view>
</view>
