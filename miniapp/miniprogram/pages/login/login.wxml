<view class="center-page">
  <image class="brand-logo" src="/assets/illustrations/brand-mark.png" mode="aspectFit" />
  <view class="brand-title">智能液位管理系统</view>
  <view class="brand-subtitle">登录查看设备数据、下发控制命令</view>

  <view class="card center-card">
    <view class="mode-tabs">
      <view class="mode-tab {{mode === 'wechat' ? 'active' : ''}}" data-mode="wechat" bindtap="onSwitchMode">微信登录</view>
      <view class="mode-tab {{mode === 'password' ? 'active' : ''}}" data-mode="password" bindtap="onSwitchMode">账号密码登录</view>
    </view>

    <block wx:if="{{mode === 'wechat'}}">
      <block wx:if="{{stage === 'restoring'}}">
        <view class="muted" style="text-align:center;padding:24rpx 0;">正在登录…</view>
      </block>
      <block wx:elif="{{stage === 'needPhone'}}">
        <view class="muted" style="text-align:center;margin-bottom:16rpx;">首次使用，请授权手机号以确认您的账号</view>
        <button class="btn-primary" open-type="getPhoneNumber" bindgetphonenumber="onGetPhoneNumber" loading="{{busy}}">
          微信手机号快捷登录
        </button>
      </block>
      <block wx:else>
        <button class="btn-primary" bindtap="onWechatLogin" loading="{{busy}}">微信登录</button>
      </block>
    </block>

    <block wx:else>
      <view class="field">
        <text class="field-label">手机号 / 用户名</text>
        <input
          class="field-input"
          type="text"
          maxlength="64"
          placeholder="手机号 / 用户名"
          value="{{account}}"
          bindinput="onAccountInput"
        />
      </view>
      <view class="field">
        <text class="field-label">密码</text>
        <input
          class="field-input"
          password
          placeholder="请输入密码"
          value="{{password}}"
          bindinput="onPasswordInput"
          bindconfirm="onPasswordLogin"
        />
      </view>
      <button class="btn-primary" bindtap="onPasswordLogin" loading="{{busy}}">登录</button>
      <view class="muted" style="margin-top:16rpx;text-align:center;">员工账号请使用微信登录</view>
    </block>

    <view wx:if="{{errorMsg}}" class="muted text-danger" style="margin-top:16rpx;text-align:center;">{{errorMsg}}</view>
  </view>
</view>
