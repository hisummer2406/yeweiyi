<view>
  <view wx:if="{{liveAlarm}}" class="card banner-danger">
    <text class="text-danger">{{text.liveAlarm}}: {{liveAlarm}}</text>
  </view>

  <view wx:if="{{notice}}" class="empty">{{notice}}</view>

  <!-- Live alarms are not arriving (the connection is down and being retried): silence is not "no alarms". -->
  <view wx:if="{{deviceActive && socketDown}}" class="card banner-warning">
    <text class="text-warning">{{text.socketDown}}</text>
  </view>

  <view class="tabs" wx:if="{{deviceActive}}">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab-item {{activeTab === item.key ? 'tab-item-active' : ''}}"
      data-tab="{{item.key}}"
      bindtap="onSwitchTab"
    >
      {{item.label}}
    </view>
  </view>

  <view class="container" wx:if="{{deviceActive}}">
    <!-- The last refresh of this tab failed; what is below is the previous read. -->
    <view wx:if="{{stale[activeTab]}}" class="card banner-warning">
      <text class="text-warning">{{stale[activeTab]}}</text>
    </view>

    <!-- 实时数据：GET /api/devices/:device/telemetry/latest -->
    <view wx:if="{{activeTab === 'snapshot'}}">
      <view wx:if="{{snapshotError}}" class="empty">
        <view class="text-danger">{{snapshotError}}</view>
        <button class="btn-primary" size="mini" bindtap="refreshActiveTab" style="margin-top:24rpx;">{{text.retry}}</button>
      </view>
      <view wx:if="{{!loading && snapshotLoaded && tanks.length === 0}}" class="empty empty-art">
        <image class="empty-art-img" src="/assets/illustrations/empty-data.png" mode="aspectFit" />
        <view>{{text.neverReported}}</view>
      </view>
      <view class="muted" wx:if="{{snapshotTs}}" style="margin-bottom:12rpx;">{{text.reportedAt}} {{snapshotTs}}</view>
      <view wx:for="{{tanks}}" wx:key="key" class="card">
        <view class="row" style="margin-bottom:16rpx;">
          <text class="tag">{{item.tankNoLabel}}　{{item.oilType || '--'}}</text>
          <text class="badge {{item.alarmState === 'ALARM' ? 'badge-failed' : (item.alarmState === 'FAULT' ? 'badge-offline' : 'badge-online')}}">{{item.alarmStateLabel}}</text>
        </view>
        <view class="tank-card-head">
          <image class="tank-illustration" src="/assets/illustrations/tank-horizontal.png" mode="aspectFit" />
          <view class="tank-card-body">
            <view class="stat-row">
              <text class="stat-row-label">{{text.level}}</text>
              <text class="stat-row-value">{{item.oilLevelMm}}</text>
              <text class="stat-row-unit">{{text.unitMm}}</text>
            </view>
            <view class="stat-row">
              <text class="stat-row-label">{{text.volume}}</text>
              <text class="stat-row-value">{{item.oilVolumeL}}</text>
              <text class="stat-row-unit">{{text.unitL}}</text>
            </view>
            <view class="stat-row">
              <text class="stat-row-label">{{text.water}}</text>
              <text class="stat-row-value">{{item.waterLevelMm}}</text>
              <text class="stat-row-unit">{{text.unitMm}}</text>
            </view>
            <view class="stat-row">
              <text class="stat-row-label">{{text.temp}}</text>
              <text class="stat-row-value">{{item.tempC}}</text>
              <text class="stat-row-unit">℃</text>
            </view>
            <view class="stat-row">
              <text class="stat-row-label">{{text.mass}}</text>
              <text class="stat-row-value">{{item.oilWeightKg}}</text>
              <text class="stat-row-unit">{{text.unitKg}}</text>
            </view>
            <view class="stat-row">
              <text class="stat-row-label">{{text.ullage}}</text>
              <text class="stat-row-value">{{item.nullVolumeL}}</text>
              <text class="stat-row-unit">{{text.unitL}}</text>
            </view>
          </view>
        </view>
        <view class="muted text-danger" wx:if="{{!item.probeConnected}}" style="margin-top:8rpx;">{{text.probeOff}}</view>
      </view>
    </view>

    <!-- 报警记录与出入库记录共用的时间范围：快捷档位滚动（按点击时的当前时间往回算），自定义按本地整天。 -->
    <view wx:if="{{activeTab === 'alarms' || activeTab === 'oilInOut'}}" class="range-bar">
      <view class="range-chips">
        <view
          wx:for="{{rangePresets}}"
          wx:key="key"
          class="range-chip {{rangeKey === item.key ? 'range-chip-on' : ''}}"
          data-key="{{item.key}}"
          bindtap="onPickRange"
        >{{item.label}}</view>
        <view class="range-chip {{rangeKey === 'custom' ? 'range-chip-on' : ''}}" data-key="custom" bindtap="onPickRange">{{text.custom}}</view>
      </view>
      <view wx:if="{{rangeKey === 'custom'}}" class="range-custom">
        <picker mode="date" value="{{customStart}}" end="{{customEnd || today}}" bindchange="onStartDate">
          <view class="range-date">{{customStart || text.startDate}}</view>
        </picker>
        <text class="range-sep">{{text.to}}</text>
        <picker mode="date" value="{{customEnd}}" start="{{customStart}}" end="{{today}}" bindchange="onEndDate">
          <view class="range-date">{{customEnd || text.endDate}}</view>
        </picker>
      </view>
      <view wx:if="{{rangeHint}}" class="muted range-hint">{{rangeHint}}</view>
    </view>

    <!-- 报警记录：GET /api/alarms（裸数组，见 types/api.d.ts），触底加载下一页 -->
    <view wx:if="{{activeTab === 'alarms'}}">
      <view wx:if="{{alarmsError}}" class="empty">
        <view class="text-danger">{{alarmsError}}</view>
        <button class="btn-primary" size="mini" bindtap="loadAlarms" style="margin-top:24rpx;">{{text.retry}}</button>
      </view>
      <view wx:if="{{!rangeHint && !loading && alarmsLoaded && alarms.length === 0 && alarmsFooter === 'end'}}" class="empty">
        {{rangeKey === '24h' ? text.alarmsEmpty24h : text.alarmsEmptyRange}}
      </view>
      <view wx:for="{{alarms}}" wx:key="rowKey" class="card">
        <view class="row">
          <text>{{item.tankLabel}}　{{item.typeLabel}}</text>
          <text class="badge {{item.status === 'ACTIVE' ? 'badge-failed' : 'badge-online'}}">{{item.statusLabel}}</text>
        </view>
        <view class="muted" style="margin-top:8rpx;">{{item.text}}</view>
        <view class="muted tabular-nums">{{item.severityLabel}}　{{item.timeText}}</view>
      </view>
      <view wx:if="{{alarmsFooter && (alarms.length > 0 || alarmsFooter !== 'end')}}" class="list-footer" bindtap="onRetryMore">
        {{alarmsFooter === 'loading' ? text.footerLoading : (alarmsFooter === 'end' ? text.footerEnd : (alarmsFooter === 'error' ? text.footerError : text.footerMore))}}
      </view>
    </view>

    <!-- 出入库记录：GET /api/oil-in-out，两条路径都返回 {rows, parsed, unparsable, legacySkipped, ...}，触底加载下一页 -->
    <view wx:if="{{activeTab === 'oilInOut'}}">
      <view wx:if="{{oilInOutNote}}" class="card" style="background-color:#fffbe6;border:1rpx solid #ffe58f;">
        <text style="color:#d48806;">{{oilInOutNote}}</text>
      </view>
      <view wx:if="{{!rangeHint && !loading && oilInOutLoaded && oilInOut.length === 0 && !oilInOutNote && oilInOutFooter === 'end'}}" class="empty">
        {{rangeKey === '24h' ? text.oilEmpty24h : text.oilEmptyRange}}
      </view>
      <view wx:for="{{oilInOut}}" wx:key="rowKey" class="card">
        <view class="row">
          <text>{{item.tankLabel}}　{{item.directionLabel}}　{{item.oilType || ''}}</text>
          <text class="muted">{{item.timeText}}</text>
        </view>
        <view class="muted tabular-nums" style="margin-top:8rpx;">
          {{text.level}} {{item.beginLevelMm}} → {{item.endLevelMm}}mm　{{text.volume}} {{item.beginVolumeL}} → {{item.endVolumeL}}L
        </view>
        <view class="muted tabular-nums">
          {{text.net}} {{item.netVolumeL}}L　{{text.delivered}} {{item.deliveredVolumeL}}L
        </view>
        <view class="muted tabular-nums">{{item.beginTimeText}} - {{item.endTimeText}}</view>
      </view>
      <view wx:if="{{oilInOutFooter && (oilInOut.length > 0 || oilInOutFooter !== 'end')}}" class="list-footer" bindtap="onRetryMore">
        {{oilInOutFooter === 'loading' ? text.footerLoading : (oilInOutFooter === 'end' ? text.footerEnd : (oilInOutFooter === 'error' ? text.footerError : text.footerMore))}}
      </view>
    </view>

    <!-- 控制命令：POST /api/devices/:device/commands 下发，GET 轮询结果 -->
    <view wx:if="{{activeTab === 'commands'}}">
      <button class="btn-primary" size="mini" bindtap="onIssueCommand" style="margin-bottom:16rpx;">{{text.cmdIssue}}</button>
      <view wx:if="{{!loading && commandsLoaded && commands.length === 0}}" class="empty">{{text.cmdNone}}</view>
      <view wx:for="{{commands}}" wx:key="commandId" class="card">
        <view class="row">
          <text>{{item.methodLabel}}</text>
          <text class="badge {{item.status === 'succeeded' ? 'badge-online' : (item.status === 'failed' || item.status === 'rejected' || item.status === 'expired' ? 'badge-failed' : (item.terminal ? 'badge-offline' : 'badge-pending'))}}">{{item.statusLabel}}</text>
        </view>
        <view class="muted" style="margin-top:8rpx;">{{text.cmdReason}}: {{item.reason}}</view>
        <view class="muted tabular-nums">{{text.cmdOperator}} {{item.operator}}　{{item.issuedAt}}</view>
        <view class="muted text-danger" wx:if="{{item.errorReason}}">{{item.errorReason}}</view>
        <view class="muted" wx:if="{{!item.terminal}}">{{text.cmdNotTerminal}}</view>
      </view>
    </view>
  </view>
</view>
