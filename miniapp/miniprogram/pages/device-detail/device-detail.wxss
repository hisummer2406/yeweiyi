/* 当前罐与罐切换（单罐详情） */
.tank-bar {
  padding: 16rpx 24rpx 0;
}

.tank-bar-target {
  margin-bottom: 4rpx;
  word-break: break-all;
}

.tank-bar-current {
  margin-bottom: 12rpx;
  font-size: var(--font-title);
  font-weight: 600;
  color: #131313;
}

/* 实时数据：当前罐的全部读数，两列网格（字号与首页共用 typography.wxss） */
.dt-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dt-probe {
  font-size: var(--font-caption);
  color: #3d434c;
  margin-bottom: 8rpx;
}

.dt-probe-off {
  color: #c62828;
  font-weight: 600;
}

.dt-grid {
  display: flex;
  flex-wrap: wrap;
}

.dt-cell {
  box-sizing: border-box;
  width: 50%;
  padding: 16rpx 8rpx 16rpx 0;
  border-top: 1rpx solid #eef1f6;
}

.dt-label {
  font-size: var(--font-body);
  color: #4a4f57;
}

.dt-value {
  margin-top: 4rpx;
  font-size: var(--font-number);
  font-weight: 600;
  color: #131313;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.dt-value-strong {
  font-size: var(--font-number);
  font-weight: 700;
}

.dt-unit {
  margin-left: 8rpx;
  font-size: var(--font-label);
  font-weight: 400;
  color: #3d434c;
}

/* 本机显示设置（#44） */
.dt-scale-tag {
  margin-bottom: 8rpx;
}

.dt-raw {
  margin-top: 2rpx;
  font-size: var(--font-caption);
  color: #6b7280;
  word-break: break-all;
}

.sc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.sc-title {
  font-size: var(--font-heading);
  font-weight: 600;
  color: #131313;
}

.sc-toggle {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: var(--font-label);
  color: #0066a2;
}

.sc-body {
  margin-top: 16rpx;
}

.sc-note {
  margin-bottom: 8rpx;
}

.sc-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  border-top: 1rpx solid #eef1f6;
}

.sc-label {
  flex: 1;
  font-size: var(--font-body);
  color: #4a4f57;
}

.sc-input {
  width: 220rpx;
  height: 64rpx;
  padding: 0 16rpx;
  border: 1rpx solid #d0d5dd;
  border-radius: 8rpx;
  font-size: var(--font-body);
  text-align: right;
}

.sc-error {
  margin-top: 8rpx;
  font-size: var(--font-caption);
}

.sc-preview {
  margin-top: 8rpx;
  font-size: var(--font-caption);
  color: #3d434c;
  word-break: break-all;
}

.sc-reset {
  margin-top: 20rpx;
}
