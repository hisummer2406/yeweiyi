
/* 报警/出入库记录的时间范围条 */
.range-bar {
  margin-bottom: 16rpx;
}

.range-chips {
  display: flex;
  flex-wrap: wrap;
}

.range-chip {
  margin: 0 16rpx 12rpx 0;
  padding: 10rpx 24rpx;
  border-radius: 28rpx;
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  font-size: 26rpx;
  color: #131313;
}

.range-chip-on {
  background: #066daa;
  border-color: #066daa;
  color: #ffffff;
}

.range-custom {
  display: flex;
  align-items: center;
  margin-top: 4rpx;
}

.range-date {
  min-width: 220rpx;
  padding: 12rpx 20rpx;
  border-radius: 12rpx;
  background: #ffffff;
  border: 1rpx solid #d9dee8;
  font-size: 26rpx;
  text-align: center;
}

.range-sep {
  margin: 0 16rpx;
  color: #8a8a8a;
  font-size: 26rpx;
}

.range-hint {
  margin-top: 8rpx;
}

/* 列表底部：加载中 / 没有更多了 / 加载失败，点击重试 */
.list-footer {
  padding: 24rpx 0 32rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8a8a8a;
}
