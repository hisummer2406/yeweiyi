/* 当前罐与罐切换（单罐详情） */
.tank-bar {
  padding: 16rpx 24rpx 0;
}

.tank-bar-current {
  margin-bottom: 12rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #131313;
}

/* 实时数据：当前罐的全部读数，两列网格（字号按 app.wxss 顶部的适老化对照表） */
.dt-head {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.dt-probe {
  font-size: 30rpx;
  color: #3d434c;
  margin-bottom: 8rpx;
}

.dt-probe-off {
  color: #c62828;
  font-weight: 600;
}

.dt-grid {
  display: flex;
  flex-wrap: wrap;
}

.dt-cell {
  box-sizing: border-box;
  width: 50%;
  padding: 16rpx 8rpx 16rpx 0;
  border-top: 1rpx solid #eef1f6;
}

.dt-label {
  font-size: 30rpx;
  color: #4a4f57;
}

.dt-value {
  margin-top: 4rpx;
  font-size: 40rpx;
  font-weight: 600;
  color: #131313;
  font-variant-numeric: tabular-nums;
  word-break: break-all;
}

.dt-value-strong {
  font-size: 46rpx;
  font-weight: 700;
}

.dt-unit {
  margin-left: 8rpx;
  font-size: 28rpx;
  font-weight: 400;
  color: #3d434c;
}
