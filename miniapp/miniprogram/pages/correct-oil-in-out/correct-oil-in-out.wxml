<view class="container">
  <view class="card muted">
    提交后为异步下发，状态会停留在“已提交”直到设备确认（当前设备侧尚未实现确认，属已知限制）。
  </view>

  <view class="card">
    <view class="field">
      <text class="field-label">记录编号（deviceLocalId）</text>
      <view class="field-input">{{form.deviceLocalId}}</view>
    </view>
    <view class="field">
      <text class="field-label">油品编号 oilId</text>
      <input class="field-input" type="number" value="{{form.oilId}}" bindinput="onInput" data-field="oilId" />
    </view>
    <view class="field">
      <text class="field-label">介质 jieZhi</text>
      <input class="field-input" value="{{form.jieZhi}}" bindinput="onInput" data-field="jieZhi" />
    </view>
    <view class="field">
      <text class="field-label">时间 time</text>
      <input class="field-input" value="{{form.time}}" bindinput="onInput" data-field="time" />
    </view>
    <view class="field">
      <text class="field-label">起始高度 beginHeigth</text>
      <input class="field-input" type="digit" value="{{form.beginHeigth}}" bindinput="onInput" data-field="beginHeigth" />
    </view>
    <view class="field">
      <text class="field-label">结束高度 endHeigth</text>
      <input class="field-input" type="digit" value="{{form.endHeigth}}" bindinput="onInput" data-field="endHeigth" />
    </view>
    <view class="field">
      <text class="field-label">起始容积 beginVolum</text>
      <input class="field-input" type="digit" value="{{form.beginVolum}}" bindinput="onInput" data-field="beginVolum" />
    </view>
    <view class="field">
      <text class="field-label">结束容积 endVolum</text>
      <input class="field-input" type="digit" value="{{form.endVolum}}" bindinput="onInput" data-field="endVolum" />
    </view>
    <view class="field">
      <text class="field-label">起始重量 beginWeight</text>
      <input class="field-input" type="digit" value="{{form.beginWeight}}" bindinput="onInput" data-field="beginWeight" />
    </view>
    <view class="field">
      <text class="field-label">结束重量 endWeight</text>
      <input class="field-input" type="digit" value="{{form.endWeight}}" bindinput="onInput" data-field="endWeight" />
    </view>

    <button class="btn-primary" loading="{{submitting}}" bindtap="onSubmit">提交修正</button>
  </view>
</view>
