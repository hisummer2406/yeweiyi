<view class="container">
  <view class="card">
    <view
      wx:for="{{rows}}"
      wx:key="value"
      class="list-row"
      data-value="{{item.value}}"
      bindtap="onPick"
    >
      <view class="list-row-body">
        <text>{{item.name}}</text>
        <view wx:if="{{item.hint}}" class="muted" style="margin-top:4rpx;">{{item.hint}}</view>
      </view>
      <text wx:if="{{item.value === selected}}" class="text-selected-mark">✓</text>
    </view>
  </view>
</view>
