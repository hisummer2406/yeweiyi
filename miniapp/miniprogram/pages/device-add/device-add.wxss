.add-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding: 56rpx 44rpx;
  background-color: #ecf0f8;
}

.add-title {
  font-size: 40rpx;
  font-weight: 600;
  text-align: center;
  color: #131313;
}

.add-subtitle {
  margin: 16rpx 0 56rpx;
  font-size: 26rpx;
  text-align: center;
  color: #8697a4;
}

.add-card {
  background-color: #ffffff;
  border-radius: 24rpx;
  padding: 48rpx;
}

.add-card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #131313;
}

.add-card-desc {
  margin: 12rpx 0 32rpx;
  font-size: 26rpx;
  color: #8697a4;
}
