/* 数值取自设计稿「首页-卧罐01」PNG（750 宽，1px = 1rpx）的像素实测，不是目测：
   头部渐变 #05629B → #004873；分隔线 #C5C9D0；标签 156×32 #03355E；读数 22rpx，行高 40rpx，
   标签/数值 #131313，单位 #505050；单台罐行高 293rpx。差异见 openspec/changes/home-by-station/tasks.md 3.8。 */
page {
  background-color: #edf0f7;
}

.btn-primary {
  margin-bottom: 24rpx;
}

/* 头部：自定义导航栏，渐变一直铺到状态栏下面（padding-top 由 TS 按状态栏高度写入） */
.home-header {
  padding: 0 30rpx 30rpx;
  background: linear-gradient(180deg, #05629b 0%, #004873 100%);
  color: #ffffff;
}

.home-brand {
  display: flex;
  align-items: center;
  height: 56rpx;
  margin-top: 17rpx;
}

.home-brand-mark {
  width: 56rpx;
  height: 56rpx;
  margin-right: 24rpx;
}

.home-brand-title {
  font-size: 36rpx;
}

.home-station {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 48rpx;
  margin-top: 55rpx;
}

.home-station-name {
  font-size: 36rpx;
}

.home-station-pick {
  display: flex;
  align-items: center;
}

/* 下拉三角：用边框画，仓库里没有现成的白色下拉图标；尺寸未对照设计稿像素校准 */
.home-station-arrow {
  width: 0;
  height: 0;
  margin-left: 16rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #ffffff;
}

.home-plus {
  width: 42rpx;
  height: 42rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-list {
  padding-bottom: 24rpx;
}

/* 设计稿没有"上报时间"这一行；它必须显示（快照不是实时流），所以做得尽量小 */
.group-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  padding: 16rpx 30rpx 0;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #131313;
}

.group-note {
  padding: 40rpx 30rpx;
  text-align: center;
  font-size: 26rpx;
  color: #8697a4;
}

/* 一行 = 293rpx：30 + 标签 32 + 11 + 5×40 + 20，含底部 1rpx 分隔线 */
.tank-row {
  display: flex;
  align-items: flex-start;
  box-sizing: border-box;
  height: 293rpx;
  margin: 0 30rpx;
  border-bottom: 1rpx solid #c5c9d0;
}

.home-tank {
  position: relative;
  width: 240rpx;
  height: 176rpx;
  flex-shrink: 0;
  margin: 87rpx 0 0 50rpx;
}

.home-tank-img {
  width: 240rpx;
  height: 176rpx;
}

/* 罐身区域（不含顶部人孔和底座），按 tank-horizontal-home.png 实测；填充只在这一块内 */
.home-tank-body {
  position: absolute;
  left: 2rpx;
  right: 2rpx;
  top: 26rpx;
  height: 139rpx;
  border-radius: 28rpx;
  overflow: hidden;
}

.fill {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.6;
}

.fill-water {
  background-color: #1e88e5;
}

.fill-oil {
  background-color: #f2a516;
}

.fill-oil.fill-alarm {
  background-color: #d93a3a;
}

.fill-oil.fill-fault {
  background-color: #8a8f98;
}

.tank-info {
  flex: 1;
  min-width: 0;
  margin-left: 64rpx;
  padding-top: 30rpx;
}

.tank-tag-row {
  display: flex;
  align-items: center;
  height: 32rpx;
  margin-bottom: 11rpx;
}

/* 「1号 甲醇」深蓝标签 */
.tank-tag {
  box-sizing: border-box;
  min-width: 156rpx;
  height: 32rpx;
  line-height: 32rpx;
  padding: 0 5rpx;
  background-color: #03355e;
  color: #ffffff;
  font-size: 22rpx;
  border-radius: 4rpx;
}

.tank-tag-row .badge {
  margin-left: 12rpx;
}

.hs-row {
  display: flex;
  align-items: center;
  height: 40rpx;
  font-size: 22rpx;
  color: #131313;
}

.hs-label {
  width: 59rpx;
  flex-shrink: 0;
}

.hs-value {
  width: 131rpx;
  flex-shrink: 0;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.hs-unit {
  font-size: 20rpx;
  color: #505050;
}
