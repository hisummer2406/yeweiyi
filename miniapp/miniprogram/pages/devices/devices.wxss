/* 数值取自设计稿「首页-卧罐01」PNG（750 宽，1px = 1rpx）的像素实测，不是目测：
   头部渐变 #05629B → #004873；分隔线 #C5C9D0；标签 156×32 #03355E；读数 22rpx，行高 40rpx，
   标签/数值 #131313，单位 #505050；单台罐行高 293rpx。差异见 openspec/changes/home-by-station/tasks.md 3.8。
   按设计图恢复图文比例；每罐高度由可用窗口减去实测头部和上报时间后四等分，不裁切第五罐以后的内容。 */
page {
  background-color: #edf0f7;
}

.btn-primary {
  margin-bottom: 24rpx;
}

/* 头部：自定义导航栏，渐变一直铺到状态栏下面（padding-top 由 TS 按状态栏高度写入） */
.home-header {
  padding: 0 30rpx 22rpx;
  background: linear-gradient(180deg, #05629b 0%, #004873 100%);
  color: #ffffff;
}

.home-brand {
  display: flex;
  align-items: center;
  min-height: 72rpx;
  margin-top: 16rpx;
  padding-right: 190rpx;
}

.home-brand-mark {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  margin-right: 12rpx;
}

.home-brand-title {
  font-size: var(--font-brand);
  line-height: 1.3;
}

.home-station {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 64rpx;
  margin-top: 32rpx;
}

.home-station-name {
  font-size: var(--font-title);
  line-height: 1.3;
  overflow-wrap: anywhere;
}

.home-station-pick {
  display: flex;
  align-items: center;
  min-width: 0;
  margin-right: 20rpx;
}

/* 下拉三角：用边框画，仓库里没有现成的白色下拉图标；尺寸未对照设计稿像素校准 */
.home-station-arrow {
  width: 0;
  height: 0;
  flex-shrink: 0;
  margin-left: 16rpx;
  border-left: 10rpx solid transparent;
  border-right: 10rpx solid transparent;
  border-top: 12rpx solid #ffffff;
}

.home-plus {
  width: 56rpx;
  height: 56rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.home-list {
  padding-bottom: 0;
}

/* 上报时间始终显示：快照不是实时流。收紧上下留白，为罐数据留出空间。 */
.group-head {
  display: flex;
  flex-wrap: wrap;
  align-items: baseline;
  justify-content: space-between;
  padding: 10rpx 30rpx 0;
  line-height: 32rpx;
}

.group-name {
  font-size: var(--font-label);
  font-weight: 600;
  color: #131313;
}

.group-ts {
  font-size: var(--font-meta);
  color: #4a4f57;
}

.group-note {
  padding: 40rpx 30rpx;
  text-align: center;
  font-size: var(--font-heading);
  color: #4a4f57;
}

/* 每罐占首屏可用高度的 1/4，内容垂直居中。长介质名/异常文字仍可撑开，保留自然滚动。 */
.tank-row {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 293rpx;
  margin: 0 30rpx;
  padding: 4rpx 0;
  border-bottom: 1rpx solid #c5c9d0;
}

/* 图片 240×176 原尺寸等比显示，填充窗口仍按百分比定位。 */
.home-tank {
  position: relative;
  width: 240rpx;
  height: 176rpx;
  flex-shrink: 0;
  margin-left: 50rpx;
}

.home-tank-img {
  width: 100%;
  height: 100%;
}

.home-tank-crop {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}

/* 原始设备素材 500×320，非透明范围 x=70..266、y=24..317（196×293）。用视口裁掉透明边，不重绘素材。
   立罐细长，限在 176rpx 框高里只有卧罐一半面积、显得小：视口放到 200rpx 高（宽 200×196/293≈134rpx），
   上下各超出罐框 12rpx、水平居中；首页罐行最矮 274rpx，放得下。内部百分比相对视口，比例不变。 */
.home-tank-crop-vertical {
  top: -12rpx;
  bottom: -12rpx;
  left: 22.13%;
  right: 22.13%;
}

.home-tank-crop-vertical .home-tank-img {
  position: absolute;
  width: 255.1%;
  height: 109.22%;
  left: -35.71%;
  top: -8.19%;
  max-width: none;
}

.home-tank-crop-vertical .home-tank-body {
  left: 19.9%;
  width: 41.33%;
  top: 10.92%;
  height: 82.94%;
}

/* 填充只在罐身中间两道箍之间的那一列（不铺满整个罐、不含顶部人孔和底座），按 tank-horizontal-home.png 实测：
   左箍外沿 x=45–53、右箍 x=107–115，所以这一列是 x=54–106（宽 52），上下沿与罐身一致（y=26–165）。
   罐图按比例缩小后用百分比表示同一块区域（54/240、52/240、26/176、139/176），面积和位置不变。 */
.home-tank-body {
  position: absolute;
  left: 22.5%;
  width: 21.67%;
  top: 14.77%;
  height: 78.98%;
  overflow: hidden;
}

.fill {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.6;
}

.fill-water {
  background-color: #1e88e5;
}

.fill-oil {
  background-color: #f2a516;
}

.fill-oil.fill-alarm {
  background-color: #d93a3a;
}

.fill-oil.fill-fault {
  background-color: #8a8f98;
}

.tank-info {
  flex: 1;
  min-width: 0;
  margin-left: 64rpx;
}

.tank-tag-row {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  margin-bottom: 4rpx;
  font-size: 0;
  line-height: 1;
}

/* 罐号 + 油品：允许换行，长油品名不截断 */
.tank-tag {
  box-sizing: border-box;
  min-width: 156rpx;
  max-width: 100%;
  padding: 0 8rpx;
  line-height: 36rpx;
  background-color: #03355e;
  color: #ffffff;
  font-size: var(--font-label);
  border-radius: 4rpx;
  word-break: break-all;
}

.tank-tag-row .badge {
  margin: 0 0 0 8rpx;
  padding: 0 8rpx;
  font-size: var(--font-status);
  line-height: 28rpx;
}

.hs-row {
  display: flex;
  max-width: 290rpx;
  align-items: center;
  min-height: 40rpx;
  line-height: 40rpx;
  font-size: var(--font-number);
  color: #131313;
}

.hs-label {
  width: auto;
  min-width: 58rpx;
  flex-shrink: 0;
  margin-right: 8rpx;
  font-size: var(--font-body);
  color: #2f3540;
}

/* 数值略大于标签，保留等宽数字，按设计图靠近标签左对齐；超长数值仍可换行，不截断。 */
.hs-value {
  flex: 1;
  min-width: 0;
  font-size: var(--font-number);
  font-weight: 600;
  font-variant-numeric: tabular-nums;
  text-align: left;
  word-break: break-all;
}

.hs-unit {
  width: 56rpx;
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: var(--font-label);
  color: #3d434c;
}

.hs-probe-status {
  display: flex;
  align-items: center;
  height: 24rpx;
  font-size: var(--font-status);
  line-height: 24rpx;
}

.hs-probe-off {
  font-weight: 600;
  color: #c62828;
}

/* 较短屏幕只收紧读数，不压缩整页；正常屏幕按上方设计图比例显示。 */
.home-compact .tank-row {
  padding: 2rpx 0;
}

.home-compact .hs-row {
  min-height: 33rpx;
  line-height: 33rpx;
  font-size: var(--font-number-compact);
}

.home-compact .hs-value {
  font-size: var(--font-number-compact);
}

.home-compact .hs-label {
  font-size: var(--font-label);
}

.home-compact .hs-unit {
  font-size: var(--font-meta);
}

.home-compact .tank-tag {
  line-height: 32rpx;
  font-size: var(--font-caption);
}

.home-compact .hs-probe-status {
  height: 22rpx;
  line-height: 22rpx;
}

.home-wide-labels .hs-row {
  max-width: none;
}

.home-wide-labels .hs-label {
  margin-right: 0;
}
