<view class="container">
  <button class="btn-primary" bindtap="onScanBind">扫码绑定设备</button>

  <view wx:if="{{!loading && devices.length === 0}}" class="empty">
    还没有绑定任何设备，点击上方按钮扫码绑定
  </view>

  <view
    wx:for="{{devices}}"
    wx:key="device_name"
    class="card"
    bindtap="onTapDevice"
    data-device="{{item.device_name}}"
  >
    <view class="row">
      <text>{{item.device_name}}</text>
    </view>
    <!-- 在线/离线状态刻意不展示：云端单栈改造后没有任何代码在更新 is_online 列，
         这里显示它只会是一个永远不变的错误答案，见 types/api.d.ts 的说明。 -->
    <view class="muted" style="margin-top:8rpx;">
      最近上线 {{item.last_online_at || '--'}}
    </view>
  </view>
</view>
