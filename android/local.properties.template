# local.properties 模板
#
# 用法：复制本文件为 local.properties（该文件不进版本库），按下面说明填值。
# app/build.gradle 会在构建期读取这些值并注入 BuildConfig，供 ApiConfig 使用。
# 缺失任何一项，构建时会打印 [配置缺失] 警告，对应常量编译为空字符串。

# --- Android SDK 路径（每台机器不同）---
# macOS 示例: sdk.dir=/Users/<你的用户名>/Library/Android/sdk
# Windows 示例: sdk.dir=D\:\\SDK
sdk.dir=
ndk.dir=

# --- 敏感凭据（找项目负责人索取，不要从 git 历史里翻）---

# 阿里云 IoT 产品 Key，用于 MQTT 上报（BackService）
sansen.productKey=

# 阿里云 IoT 产品密钥
sansen.productSecret=

# 接口请求体 3DES 加密密钥（Base64 编码形式，见 OkgoNet.simplenessPost）
sansen.requestEncryptKey=

# 服务端基址，例如 http://<host>:<port>
sansen.baseUrl=
