<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >
	
    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_centerHorizontal="true"
    	android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2">
        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center_vertical"

            />
        <TextView 
             android:layout_width="match_parent"
             android:layout_height="wrap_content"
             android:text="@string/maintenance_ersonnel"
             android:textColor="@android:color/white"
             android:textSize="18sp"
             android:gravity="center_vertical"
             android:layout_marginBottom="3dp"

         />
    </LinearLayout>
    
    <RadioGroup
        android:id="@+id/maintenance_rg_group"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
		android:background="#e0ffffff"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@id/bar_set"
        >

        <android.support.v7.widget.AppCompatRadioButton
            android:id="@+id/maintenance_rb_sasen"
            android:layout_width="fill_parent"  
            android:layout_height="wrap_content"  
            android:background="@android:color/transparent"  
            android:button="@null"  
            android:checked="true"  
            android:drawableRight="@android:drawable/btn_radio"  
            android:paddingLeft="5dip"
            android:text="@string/sansen" />
       <android.support.v7.widget.AppCompatRadioButton    
            android:id="@+id/maintenance_rb_zhengxing"
            android:layout_width="fill_parent"  
            android:layout_height="wrap_content"  
            android:background="@android:color/transparent"  
            android:button="@null"  
            android:checked="true"  
            android:drawableRight="@android:drawable/btn_radio"  
            android:paddingLeft="5dip"
           android:text="@string/zhengxing" />
       <android.support.v7.widget.AppCompatRadioButton    
            android:id="@+id/maintenance_rb_null"
            android:layout_width="fill_parent"  
            android:layout_height="wrap_content"  
            android:background="@android:color/transparent"  
            android:button="@null"  
            android:checked="true"  
            android:drawableRight="@android:drawable/btn_radio"  
            android:paddingLeft="5dip"
            android:text="@string/nosetcom" />
    </RadioGroup>

</LinearLayout>