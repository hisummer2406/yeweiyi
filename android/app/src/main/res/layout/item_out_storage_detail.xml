<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.xinchen.allInOne.ui.recycleModel.OutStorageDetailRecycleViewModel" />

        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.recycleModel.OutStorageDetailRecycleViewModel" />

    </data>
 <!--android:background="@{viewModel.isBackground ?@color/color_2291FF :@color/transform }"-->
    <LinearLayout
        android:background="@{viewModel.isBackground ?@color/color_2291FF :@color/transform }"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="@dimen/dp_24dp">
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.qrcode}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9"
            />
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.weightRk}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9"
            />
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.warehouseName}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9"
            />
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.weight}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9"
            />


    <!--    <TextView
            binding:onClickCommand="@{viewModel.itemClick}"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="查看"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9"
            />-->

    </LinearLayout>
</layout>