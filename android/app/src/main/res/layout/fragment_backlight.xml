<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2"
        android:orientation="horizontal"
         >
        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center_vertical"

            />
        <TextView 
             android:layout_width="wrap_content"
             android:layout_height="match_parent"
             android:text="@string/backlight"
             android:textColor="@android:color/white"
             android:textSize="18sp"
             android:gravity="center_vertical"
         />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/backlight_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:focusable="true"
		android:background="#e0ffffff"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginBottom="10dp"
        android:layout_below="@id/bar_set">

        <TextView
            android:id="@+id/fragment_BacklightDis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_above="@+id/linearLayoutBacklightSet"
            android:layout_centerHorizontal="true"
            android:text="0"
            android:textColor="#FF0000FF"
            android:textSize="25sp" />

        <LinearLayout
            android:id="@+id/linearLayoutBacklightSet"
            android:layout_width="wrap_content"
            android:layout_height="200dp"
            android:layout_centerInParent="true"
            android:orientation="vertical" >

            <SeekBar
                android:id="@+id/seekBarBackLight"
                android:layout_width="400dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="100dp"
                android:max="240" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearLayoutEditBacklight"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignLeft="@+id/linearLayoutBacklightSet"
            android:layout_below="@+id/linearLayoutBacklightSet"
            android:orientation="horizontal" >

            <android.support.v7.widget.AppCompatEditText
                android:id="@+id/editTextAutoBackValue"
                android:layout_width="200dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:digits="0123456789"
                android:maxLength="5"
                 />
            <android.support.v7.widget.AppCompatTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/minute" />

            <android.support.v7.widget.AppCompatButton
                android:id="@+id/buttonStartAutoBacklight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_open_back_light"/>

            <android.support.v7.widget.AppCompatButton
                android:id="@+id/buttonStopAutoBacklight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/auto_close_back_light"
/>
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>