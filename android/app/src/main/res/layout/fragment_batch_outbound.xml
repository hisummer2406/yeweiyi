<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>

        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />

        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />

        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.cSOutStorage.BatchOutboundFragmentModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical"
        android:paddingTop="@dimen/dp_10dp"
        tools:context="com.xinchen.allInOne.ui.outStorageMange.OutboundListActivity">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_23dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:background="@drawable/bg_top_2291ff_corner4"
            android:orientation="horizontal">

            <!--<TextView
                android:layout_marginLeft="@dimen/dp_20dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:text="标签编码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />-->

            <TextView
                android:layout_marginLeft="@dimen/dp_15dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="2"
                android:gravity="center"
                android:text="数字识别码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="废物名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="废物重量（kg）"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="收集时间"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>

        <com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout
            android:id="@+id/twinklingRefreshLayout"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            binding:onLoadMoreCommand="@{viewModel.onLoadMoreCommand}"
            binding:onRefreshCommand="@{viewModel.onRefreshCommand}"
            binding:tr_head_height="80dp"
            binding:tr_wave_height="80dp">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                binding:itemBinding="@{viewModel.itemBinding}"
                binding:items="@{viewModel.observableList}"
                binding:layoutManager="@{LayoutManagers.linear()}" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="没有更多内容"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12"
                android:visibility="@{viewModel.noContent}" />

        </com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="@dimen/dp_20dp"
            android:orientation="horizontal">
            <CheckBox
                android:layout_width="@dimen/dp_20dp"
                android:layout_height="@dimen/dp_20dp"
                android:layout_marginLeft="@dimen/dp_20dp"
                android:button="@drawable/selector_radio_button"
                android:checked="@={viewModel.allCheck}"
                android:gravity="center"
                android:onCheckedChanged="@{viewModel::onCheckedChanged}"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="全选"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_marginLeft="@dimen/dp_5dp"
                android:gravity="center_vertical"
                android:text="@{@string/selected+String.valueOf(viewModel.totalAccount)+@string/total_weight+String.valueOf(viewModel.totalWeight)+@string/Kg}"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="@dimen/dp_120dp"
                android:layout_height="@dimen/dp_24dp"
                android:background="@drawable/rc_2291ff_4"
                android:gravity="center"
                android:text="自行利用处置出库"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_8"
                binding:onClickCommand="@{viewModel.selfOutbound}" />

            <TextView
                android:layout_width="@dimen/dp_120dp"
                android:layout_height="@dimen/dp_24dp"
                android:layout_marginLeft="@dimen/dp_53dp"
                android:background="@drawable/rc_2291ff_4"
                android:gravity="center"
                android:text="委外出库"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_8"
                binding:onClickCommand="@{viewModel.entrustOutbound}" />
        </LinearLayout>
    </LinearLayout>
</layout>