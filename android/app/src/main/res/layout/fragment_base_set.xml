<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF0F7"
    android:orientation="vertical">
    <include
        android:id="@+id/title_bar"
        layout="@layout/layout_title_bar2" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_below="@+id/bar_set"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginBottom="10dp"
        android:background="@color/white"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_weight="5"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/dp_30"
            android:paddingLeft="@dimen/dp_50"
            android:paddingRight="@dimen/dp_50"
            android:orientation="vertical">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
              >
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/outlet_time_threshold"
                    />
                <EditText
                    android:imeOptions="actionDone"
                    android:id="@+id/et_outTime"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_131"
                    android:inputType="number"
                    android:layout_height="@dimen/dp_43"
                    
                    android:textSize="@dimen/sp_22"
                    android:hint="@string/please_enter"/>
                <TextView
                    android:layout_marginLeft="@dimen/dp_3"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:text="@string/unit_second"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/outlet_height_threshold"
                    />
                <EditText
                    android:imeOptions="actionDone"
                    android:id="@+id/et_outHight"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_131"
                    android:inputType="number"
                    android:layout_height="@dimen/dp_43"
                    
                    android:textSize="@dimen/sp_22"
                    android:hint="@string/please_enter"/>
                <TextView
                    android:layout_marginLeft="@dimen/dp_3"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:text="@string/mm"
                    />
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                >
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/inlet_time_threshold"
                    />
                <EditText
                    android:imeOptions="actionDone"
                    android:id="@+id/et_inTime"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_131"
                    android:inputType="number"
                    android:layout_height="@dimen/dp_43"
                    
                    android:textSize="@dimen/sp_22"
                    android:hint="@string/please_enter"/>
                <TextView
                    android:layout_marginLeft="@dimen/dp_3"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:text="@string/unit_second"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                >
                <TextView

                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/inlet_height_threshold"
                    />
                <EditText
                    android:imeOptions="actionDone"
                    android:id="@+id/et_inHight"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_131"
                    android:inputType="number"
                    android:layout_height="@dimen/dp_43"
                    
                    android:textSize="@dimen/sp_22"
                    android:hint="@string/please_enter"/>
                <TextView
                    android:layout_marginLeft="@dimen/dp_3"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:text="@string/mm"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_43"
                android:layout_gravity="center"
                android:orientation="horizontal"
                >
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/language_selection"
                    />
                <Spinner
                    android:id="@+id/sp_yuyan"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:entries="@array/language"
                    android:layout_width="@dimen/dp_131"
                    android:layout_height="@dimen/dp_43"
                    android:background="@drawable/sansen_drop"
                    android:gravity="center_horizontal"

                    android:textSize="@dimen/fontSize" />

            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_43"
                android:orientation="horizontal"
                >
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/level_unit"
                    />
                <Spinner
                    android:id="@+id/sp_yewei"
                    android:layout_width="@dimen/dp_131"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_height="@dimen/dp_43"
                    android:background="@drawable/sansen_drop"
                    android:gravity="center_horizontal"
                    android:entries="@array/yewei_unit"
                    android:textSize="@dimen/fontSize" />

            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_43"
                android:orientation="horizontal"
                >
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/volume_unit"
                    />
                <Spinner
                    android:id="@+id/sp_rongji"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_131"
                    android:layout_height="@dimen/dp_43"
                    android:background="@drawable/sansen_drop"
                    android:gravity="center_horizontal"
                    android:entries="@array/rongji_unit"
                    android:textSize="@dimen/fontSize" />

            </LinearLayout>
            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_43"
                android:orientation="horizontal"
                >
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="@dimen/dp_142"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_22"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/mass_unit"
                    />
                <Spinner
                    android:id="@+id/sp_zhiliang"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_131"
                    android:layout_height="@dimen/dp_43"
                    android:background="@drawable/sansen_drop"
                    android:gravity="center_horizontal"
                    android:entries="@array/zhiliang_unit"
                    android:textSize="@dimen/fontSize"
                    />

            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="@dimen/dp_0"
            android:layout_weight="2"
            android:layout_height="match_parent"
            android:paddingTop="@dimen/dp_30"
            android:paddingRight="@dimen/dp_40"
            android:orientation="vertical">

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/dp_60"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_marginRight="@dimen/dp_40"
            android:id="@+id/ly_saveData"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_width="@dimen/dp_150"
            android:layout_height="wrap_content"
            android:background="#0066A2"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bc"/>
            <TextView
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:layout_gravity="center"
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="@string/save_data"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ly_upper_page"
            android:layout_marginRight="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_width="@dimen/dp_150"
            android:layout_height="wrap_content"
            android:background="#0066A2"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/fh"/>
            <TextView
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:layout_gravity="center"
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="@string/previous_page"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>