<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2"
        >
        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center_vertical"

            />
        <TextView
             android:layout_width="wrap_content"
             android:layout_height="match_parent"
             android:text="@string/tank_table"
             android:textColor="@android:color/white"
             android:textSize="18sp"
             android:gravity="center_vertical"
         />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/oilcantalbe_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusableInTouchMode="true"
        android:clickable="true"
        android:focusable="true"
        android:layout_below="@id/bar_set"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:background="#e0ffffff"
        android:orientation="vertical" >

        <LinearLayout
            android:id="@+id/oilcantable_linear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginLeft="30dp"
            android:layout_marginRight="30dp"
            android:orientation="horizontal" >

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/tank_no"
                android:paddingTop="3dp"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/oilcantable_tv_pos"
                android:layout_width="0dp"
                android:layout_weight="1.2"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:paddingTop="3dp"
                android:background="@drawable/sansen_drop"
                android:textSize="18sp" />
			<TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="20dp"
                android:paddingTop="3dp"
                android:text="@string/select_tank"
                android:textSize="18sp" />
            <LinearLayout
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="wrap_content" 
                >

                <android.support.v7.widget.AppCompatButton
                    android:id="@+id/oilcantable_ib_left"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="@drawable/sansen_left_but_selector" />

                <android.support.v7.widget.AppCompatButton
                    android:id="@+id/oilcantable_ib_right"
                    android:layout_width="0dp"
                    android:layout_height="35dp"
                    android:layout_weight="1"
                    android:background="@drawable/sansen_right_but_selector"
                    />
            </LinearLayout>

            <android.support.v7.widget.AppCompatButton
                android:id="@+id/oilcantable_bt_copy"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:text="@string/copy"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"
                />
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/oilcantable_bt_points"
                android:layout_width="0dp"
                android:layout_weight="1.5"
                android:layout_height="40dp"
                android:text="@string/points"
                android:layout_marginLeft="5dp"
                android:layout_marginRight="5dp"
                android:layout_marginBottom="5dp"/>
        </LinearLayout>

        <android.support.v7.widget.RecyclerView
            android:id="@+id/oilcantable_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:layout_marginLeft="@dimen/oilcan_table_list_left"
            android:layout_marginRight="@dimen/oilcan_table_list_right"
            android:scrollbarSize="80dp"
            android:fadeScrollbars="false"
            android:fastScrollAlwaysVisible="true"
            android:scrollbars="vertical"
            android:divider="@null"
            android:fastScrollEnabled="true"/>
    </LinearLayout>

</RelativeLayout>