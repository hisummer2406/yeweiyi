<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.outStorageManage.OutStorageViewModel" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical"
        tools:context="com.xinchen.allInOne.ui.label.LabelSearchActivity">
        <include layout="@layout/include_title"
            binding:backClick="@{viewModel.backClick}"
            binding:entrity="@{entrity}"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_24dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:background="@drawable/rc_gd_1357bc_4">
            <TextView
                android:gravity="center"
                android:textSize="@dimen/sp_10"
                binding:onClickCommand="@{viewModel.scantype}"
                android:layout_width="@dimen/dp_100dp"
                android:layout_height="match_parent"
                android:background="@{viewModel.isBatch ? @drawable/rc_00cd7b_4:@drawable/rc_6e8eb8_4}"
                android:text="@{viewModel.isBatch ? @string/multiple_scan:@string/once_scan }"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="扫描二维码"
                android:paddingLeft="@dimen/dp_18dp"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                android:gravity="center_vertical"/>
            <TextView
                android:layout_marginLeft="@dimen/dp_20dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="@dimen/sp_8"
                android:maxLines="1"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:singleLine="true"
                android:layout_height="match_parent"
                android:text="@{viewModel.qrcode}"
                />
            <TextView
                android:textSize="@dimen/sp_10"
                android:gravity="center_vertical"
                android:layout_marginLeft="@dimen/dp_50dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="@color/white"
                android:text="废物数量: "
                />
            <TextView
                android:layout_marginLeft="@dimen/dp_5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_9"
                android:gravity="center_vertical"
                android:text="@{String.valueOf(viewModel.labelCount)}"
                />
            <TextView
                android:textSize="@dimen/sp_10"
                android:gravity="center_vertical"
                android:layout_marginLeft="@dimen/dp_20dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="@color/white"
                android:text="废物总重量(kg): "
                />
            <TextView
                android:layout_marginLeft="@dimen/dp_5dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_9"
                android:gravity="center_vertical"
                android:text="@{String.valueOf(viewModel.labelWeight)}"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:background="@drawable/bg_top_2291ff_corner4"
            android:layout_marginTop="@dimen/dp_16dp"
            android:gravity="center_vertical"
            android:layout_height="@dimen/dp_23dp">
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物类别"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物代码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="数字识别码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物重量(Kg)"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="@dimen/sp_9"
                android:text="操作"
                android:textColor="@color/white" />
        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_weight="1">
            <com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout
                android:id="@+id/twinklingRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                binding:tr_head_height="@dimen/dp_80dp"
                binding:tr_wave_height="@dimen/dp_80dp">

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    binding:itemBinding="@{viewModel.itemBinding}"
                    binding:items="@{viewModel.observableList}"
                    binding:layoutManager="@{LayoutManagers.linear()}" />
            </com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="@dimen/sp_12"
                android:text="没有更多内容"
                android:textColor="@color/white"
                android:visibility="@{viewModel.noContent}" />

        </RelativeLayout>
        <TextView
            android:layout_marginTop="@dimen/dp_10dp"
            android:layout_marginBottom="@dimen/dp_20dp"
            android:layout_gravity="center_horizontal"
            android:layout_width="@dimen/dp_100dp"
            android:layout_height="@dimen/dp_24dp"
            android:text="下一步"
            binding:onClickCommand="@{viewModel.nextPage}"
            android:gravity="center"
            android:textColor="@color/white"
            android:background="@drawable/rc_2291ff_4"
            android:textSize="@dimen/sp_10"
            />
    </LinearLayout>
</layout>