<?xml version="1.0" encoding="utf-8"?>


<!--android:background="@{viewModel.isBackground ?@color/color_2291FF :@color/transform }"-->
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.xinchen.allInOne.ui.recycleModel.LianDanlListRecycleViewModel" />
        <import type="com.xinchen.allInOne.utils.TypeUtils"/>
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.recycleModel.LianDanlListRecycleViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_25dp"
        android:background="@{viewModel.isBackground ?@color/color_2291FF :@color/transform}"
        android:layout_marginTop="@dimen/dp_5dp"
        android:orientation="horizontal">
        <TextView
            android:text="@{viewModel.entity.transferTime}"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9" />
        <TextView
            android:text="@{viewModel.entity.gjldbh}"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9" />

        <TextView
            android:text="@{viewModel.entity.lianDanNo}"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9" />




        <TextView
            binding:onClickCommand="@{viewModel.getview}"
            android:layout_width="@dimen/dp_50dp"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="选择"
            android:id="@+id/bt_item"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_9" />


    </LinearLayout>
</layout>
