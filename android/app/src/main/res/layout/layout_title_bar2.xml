<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <variable
            name="entity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />

    </data>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_83"
    android:background="#004873"
     >
    <TextView
        android:layout_centerInParent="true"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textSize="@dimen/sp_30"
        android:gravity="center"
        android:text="@{entity.title}"
       />
    <ImageView

        android:layout_alignParentEnd="true"
        android:layout_toRightOf="@+id/main_time"
        android:layout_width="@dimen/dp_30"
        android:layout_height="match_parent"
        android:src="@mipmap/sj_1"
        />


    <TextView
       android:layout_alignParentEnd="true"
        android:id="@+id/main_time"
        android:layout_marginRight="@dimen/dp_30"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textColor="@color/white"
        android:text="@{entity.time}"
        android:textSize="@dimen/sp_20" />
</RelativeLayout>
</layout>