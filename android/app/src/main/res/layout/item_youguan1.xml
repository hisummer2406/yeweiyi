<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.xinchen.allInOne.ui.recycleModel.FunctionRecycleViewModel" />

        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.recycleModel.FunctionRecycleViewModel" />

    </data>
    <LinearLayout
        android:padding="@dimen/dp_20dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        >

        <ProgressBar
            android:id="@+id/determinateBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="100"
            android:progressBackgroundTint="@color/red"
            android:progressTint="@color/green"
            android:progress="30"
            android:rotation="270" />

        <ImageView
            android:layout_gravity="bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@mipmap/icon_yg"/>
        <LinearLayout
            android:layout_width="@dimen/dp_40dp"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:gravity="center"
                android:layout_marginBottom="@dimen/dp_2dp"
                android:background="@color/blue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:text="@{viewModel.youGuanEntity.youGuanName}"
                android:textSize="@dimen/sp_15"
                android:hint="1号 甲醇  95#"
                android:textColor="@color/white"/>
            <TextView
                android:text="@{viewModel.youGuanEntity.yeWei}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_2"
                android:textSize="@dimen/sp_15"
                android:hint="液位  1666 厘米"
                android:textColor="@color/black"/>
            <TextView
                android:text="@{viewModel.youGuanEntity.rongJi}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_15"
                android:layout_marginBottom="@dimen/dp_2"
                android:hint="容积  1666 厘米"
                android:textColor="@color/black"/>
            <TextView
                android:text="@{viewModel.youGuanEntity.shuiGao}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_2"
                android:textSize="@dimen/sp_15"
                android:hint="水高  1666 厘米"
                android:textColor="@color/black"/>
            <TextView
                android:text="@{viewModel.youGuanEntity.wenDu}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/dp_2"
                android:textSize="@dimen/sp_15"
                android:hint="温度  1666 厘米"
                android:textColor="@color/black"/>

            <TextView
                android:text="@{viewModel.youGuanEntity.zhiLiang}"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:textSize="@dimen/sp_15"
                android:hint="质量  1666 厘米"
                android:textColor="@color/black"/>

        </LinearLayout>

    </LinearLayout>


</layout>