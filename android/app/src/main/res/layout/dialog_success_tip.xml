<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:gravity="center"
    android:layout_height="match_parent">
    <LinearLayout
        android:background="@drawable/rc_ffffff_4"
        android:layout_width="@dimen/dp_300dp"
        android:orientation="vertical"
        android:layout_height="@dimen/dp_200dp">
        <TextView
            android:id="@+id/dialog_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="跨省出库"
            android:textSize="@dimen/sp_14"
            android:gravity="center"/>
        <TextView
            android:id="@+id/dialog_content"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0dp"
            android:layout_weight="1"
            android:textSize="@dimen/sp_8"
            android:layout_margin="@dimen/dp_12dp"
           />

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">
            <Button
                android:id="@+id/dialog_success"
                android:layout_width="@dimen/dp_100dp"
                android:textSize="@dimen/sp_10"
                android:background="@drawable/rc_1357bc_4"
                android:layout_height="@dimen/dp_35dp"
                android:text="确定"/>
            <Button
                android:id="@+id/dialog_cancel"
                android:layout_width="@dimen/dp_100dp"
                android:background="@drawable/rc_6e8eb8_4"
                android:layout_height="@dimen/dp_35dp"
                android:textSize="@dimen/sp_10"
                android:text="取消"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>