<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:binding="http://schemas.android.com/apk/res-auto">


    <data>

        <import type="com.xinchen.allInOne.ui.recycleModel.WasterListRecycleViewModel" />
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.recycleModel.WasterListRecycleViewModel" />

    </data>

    <LinearLayout
        android:layout_marginTop="@dimen/dp_15dp"
        android:layout_marginBottom="@dimen/dp_15dp"
        android:layout_marginLeft="@dimen/dp_10dp"
        android:layout_marginRight="@dimen/dp_10dp"
        android:layout_width="@dimen/dp_128dp"
        android:gravity="center_vertical"
        binding:onClickCommand="@{viewModel.itemClick}"
        android:background="@mipmap/main_button_background"
        android:orientation="horizontal"
        android:layout_height="@dimen/dp_80dp">
        <ImageView
            android:layout_width="@dimen/dp_3dp"
            android:layout_height="@dimen/dp_30dp"
            app:imageUrl="@{viewModel.color}"/>
        <LinearLayout
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:orientation="vertical">
            <TextView
                android:layout_marginLeft="@dimen/dp_10dp"
                android:layout_marginTop="@dimen/dp_5dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:text="@{viewModel.entity.wasteName}"
                android:textColor="#ffffffff"
                android:gravity="center"
                android:textSize="@dimen/sp_8"
                />
           <!--  android:text="@{viewModel.isStorageType ? viewModel.entity.wasteName : viewModel.entity.wasteName+'('+viewModel.entity.num+')'}"-->
            <TextView
                android:layout_marginLeft="@dimen/dp_10dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="left|center_vertical"
                android:layout_marginBottom="@dimen/dp_3dp"
                android:text="@{`废物类别：` +viewModel.entity.wasteType}"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_marginLeft="@dimen/dp_10dp"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="left"
                android:text="@{`危废代码：` +viewModel.entity.wasteCode}"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_7"
                />
        </LinearLayout>

    </LinearLayout>
</layout>