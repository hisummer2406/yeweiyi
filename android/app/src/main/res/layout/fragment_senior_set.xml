<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF0F7"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/layout_title_bar2" />

    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_below="@+id/bar_set"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginBottom="10dp"
        android:layout_weight="1"
        android:orientation="horizontal">


    </LinearLayout>
    <LinearLayout
       android:layout_marginTop="@dimen/dp_20"
        android:layout_marginLeft="@dimen/dp_231"
        android:layout_marginRight="@dimen/dp_231"
        android:layout_marginBottom="@dimen/dp_20"
        android:paddingTop="@dimen/dp_20"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
       >

        <!-- 第一行：管理员密码、报表设置、补录记录 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- 管理员密码 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:id="@+id/ly_mima"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_admin_pwd"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:padding="16dp"
                    android:src="@drawable/gj_mima" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="管理员密码"
                    android:textColor="#222222"
                    android:textSize="34sp" />
            </LinearLayout>

            <!-- 报表设置 -->
            <LinearLayout
                android:id="@+id/ly_baobiao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_report_set"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:padding="16dp"
                    android:src="@drawable/gj_bb" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="报表设置"
                    android:textColor="#222222"
                    android:textSize="34sp" />
            </LinearLayout>

            <!-- 补录记录 -->
            <LinearLayout
                android:id="@+id/ly_bulu"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_record_add"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:padding="16dp"
                    android:src="@drawable/gj_bl" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="补录记录"
                    android:textColor="#222222"
                    android:textSize="34sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- 第二行：串口设置、演示模式 -->
        <LinearLayout
            android:id="@+id/ly_chuankou"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <!-- 串口设置 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_serial_set"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:padding="16dp"
                    android:src="@drawable/gj_ck" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="串口设置"
                    android:textColor="#222222"
                    android:textSize="34sp" />
            </LinearLayout>

            <!-- 演示模式 -->
            <LinearLayout
                android:id="@+id/ly_yanshi"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_demo_mode"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:padding="16dp"
                    android:src="@drawable/gj_ys" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="演示模式"
                    android:textColor="#222222"
                    android:textSize="34sp" />
            </LinearLayout>

            <!-- 空白占位，保证两行对齐 -->
            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />
        </LinearLayout>

    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dp_60"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/ly_upper_page"
            android:layout_width="@dimen/dp_150"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_marginRight="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_20"
            android:background="#0066A2"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/fh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:text="返回首页"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_20" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>