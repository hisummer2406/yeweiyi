<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>
        <import type="com.xinchen.allInOne.ui.recycleModel.EnvironmentRecycleViewModel" />

        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.recycleModel.EnvironmentRecycleViewModel" />
        <variable
            name="imageView"
            type="com.xinchen.allInOne.utils.BingdingImageUtils" />
    </data>

    <RelativeLayout
        android:layout_marginTop="@dimen/dp_10dp"
        android:layout_marginLeft="@dimen/dp_30dp"
        android:layout_width="@dimen/dp_60dp"
        binding:onClickCommand="@{viewModel.itemClick}"
        android:layout_height="@dimen/dp_55dp">

        <TextView
            android:id="@+id/tv_environmentValue"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_23dp"
            android:gravity="center"
            android:text="@{viewModel.entity.avgVar}"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_9"
            android:layout_marginBottom="@dimen/dp_3dp" />

        <ImageView
            android:layout_width="@dimen/dp_4dp"
            android:layout_height="@dimen/dp_8dp"
            android:layout_below="@+id/tv_environmentValue"
            android:layout_marginTop="@dimen/dp_4dp"
            app:image="@{imageView.setColor}"
            />

        <TextView
            android:layout_alignParentRight="true"
            android:layout_below="@+id/tv_environmentValue"
            android:layout_width="@dimen/dp_52dp"
            android:layout_height="@dimen/dp_15dp"
            android:background="@drawable/rc_gd_login_2291ff_4"
            android:text="@{viewModel.entity.envType}"
            android:gravity="center"
            android:textColor="#ffeff5ff"
            android:textSize="@dimen/sp_8" />
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_alignParentBottom="true">
            <TextView
                android:textSize="@dimen/sp_9"
                android:layout_width="wrap_content"
                android:textColor="@color/white"
                android:layout_height="wrap_content"
                android:text="报警数量 : "/>
            <TextView
                android:textSize="@dimen/sp_9"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@{viewModel.entity.count}"/>

        </LinearLayout>
    </RelativeLayout>
</layout>