<?xml version="1.0" encoding="utf-8"?>
<layout>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/bar_set"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:layout_marginLeft="58.5dp"
            android:layout_marginTop="16dp"
            android:layout_marginRight="59dp"
            android:background="@drawable/sansen_record_info_bar_2"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/bar_iv_icon"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center_vertical"
                android:layout_marginLeft="10dp"
                android:layout_marginRight="10dp"

                />

            <TextView
                android:id="@+id/fragmet_title"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="@string/fyf_title"
                android:textColor="@android:color/white"
                android:textSize="18sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/bar_set"
            android:layout_marginLeft="58.5dp"
            android:layout_marginRight="59dp"
            android:layout_marginBottom="10dp"
            android:background="#e0ffffff"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="@string/fyf_open"
                    android:textSize="16sp" />

                <CheckBox
                    android:id="@+id/fyf_open"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="10dp"
                    android:background="@drawable/sansen_wifi_checkbox_selector"
                    android:button="@null" />
                <RadioGroup
                    android:id="@+id/radio_groupId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <RadioButton
                        android:id="@+id/qyb_mod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Dump_pump_mode"
                        />
                    <RadioButton
                        android:id="@+id/fyf_mod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Anti_overflow_valve_mode"
                        />
                    <RadioButton
                        android:id="@+id/mixing_mod"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mixed_mode"
                        />
                </RadioGroup>

                <RadioGroup
                    android:id="@+id/board_groupId"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginLeft="10dp">
                    <RadioButton
                        android:id="@+id/one_board"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/veneer"
                        />
                    <RadioButton
                        android:id="@+id/two_board"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/double_board"
                        />
                </RadioGroup>
            </LinearLayout>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/fyf_recyler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            </android.support.v7.widget.RecyclerView>

            <android.support.v7.widget.AppCompatButton
                android:id="@+id/fyf_record_but"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/fyf_record_but" />
        </LinearLayout>
    </RelativeLayout>
</layout>
