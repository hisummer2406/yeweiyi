<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto">


    <data>
        <import type="com.xinchen.allInOne.utils.TypeUtils"/>
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.labelSupplement.LabelSupplementDetailModel" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical"
        >
        <include layout="@layout/include_title"
            binding:backClick="@{viewModel.backClick}"
            binding:entrity="@{entrity}"
            />
        <TextView
            android:paddingLeft="@dimen/dp_20dp"
            android:paddingRight="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:text="联单信息"
            android:gravity="center_vertical"
            android:textColor="@color/white"
            android:background="@color/color_2291FF"
            android:textSize="@dimen/sp_10"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:paddingLeft="@dimen/dp_20dp"
            android:paddingRight="@dimen/dp_20dp"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/countryLianDanNo+@string/colon+viewModel.entityDetail.countryLianDanNo}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/provincialLianDanNo+@string/colon +viewModel.entityDetail.lianDanNo}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/removeWeight+@string/colon +viewModel.entityDetail.transferWeight}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
        </LinearLayout>
        <TextView
            android:paddingLeft="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:text="@{@string/receiveWeight+@string/colon +viewModel.entityDetail.receiveWeight}"
            android:gravity="center_vertical"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_10"
            />
        <TextView
            android:paddingLeft="@dimen/dp_20dp"
            android:paddingRight="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:text="补录前信息"
            android:gravity="center_vertical"
            android:textColor="@color/white"
            android:background="@color/color_2291FF"
            android:textSize="@dimen/sp_10"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:paddingLeft="@dimen/dp_20dp"
            android:paddingRight="@dimen/dp_20dp"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/wasteName+@string/colon+viewModel.entityDetail.generatedWasteName}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/wastetype+@string/colon+viewModel.entityDetail.generatedWasteType}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/wastecode+@string/colon+viewModel.entityDetail.generatedWasteCode}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
        </LinearLayout>
        <TextView
            android:paddingLeft="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:text="@{@string/labelAcc+@string/colon+viewModel.entityDetail.originalLabelList.size()}"
            android:gravity="center_vertical"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_10"
            />
        <TextView
            android:paddingLeft="@dimen/dp_20dp"
            android:paddingRight="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:text="补录后信息"
            android:gravity="center_vertical"
            android:textColor="@color/white"
            android:background="@color/color_2291FF"
            android:textSize="@dimen/sp_10"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:paddingLeft="@dimen/dp_20dp"
            android:paddingRight="@dimen/dp_20dp"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/wasteName+@string/colon+viewModel.entityDetail.wasteName}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/wastetype+@string/colon+viewModel.entityDetail.wasteType}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/wastecode+@string/colon+viewModel.entityDetail.wasteCode}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
        </LinearLayout>
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:paddingLeft="@dimen/dp_20dp"
            android:paddingRight="@dimen/dp_20dp"
            android:orientation="horizontal"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/labelAcc+@string/colon+viewModel.entityDetail.supplementLabelList.size()}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/supplemenTime+@string/colon+viewModel.entityDetail.createTime}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@{@string/supplemenStatus+@string/colon+TypeUtils.StatusType(viewModel.entityDetail.status)}"
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                />
        </LinearLayout>

    </LinearLayout>
</layout>