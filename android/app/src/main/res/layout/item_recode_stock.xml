<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal" >
    
    <TextView
		android:visibility="gone"
        android:id="@+id/inout_tv_id"
        android:padding="8dp"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
    	android:layout_height="wrap_content"
    	android:textSize="18sp"
    />
     <TextView 
        android:id="@+id/inout_tv_guan_hao"
        android:padding="8dp"
        android:layout_width="0dp"
        android:layout_weight="1"
        android:gravity="center_horizontal"
    	android:layout_height="wrap_content"
    	android:textSize="18sp"
    />
	<TextView
		android:id="@+id/inout_tv_jie_zhi"
		android:padding="8dp"
		android:layout_width="0dp"
		android:layout_weight="1"
		android:gravity="center_horizontal"
		android:layout_height="wrap_content"
		android:textSize="18sp"
		/>
    <TextView 
        android:id="@+id/inout_tv_time"
        android:padding="8dp"
        android:layout_width="0dp"
        android:gravity="center_horizontal"
        android:layout_weight="3"
    	android:layout_height="wrap_content"
    	android:textSize="18sp"
    />
    <TextView 
        android:id="@+id/inout_tv_beginheight"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:layout_width="0dp"
        android:layout_weight="2"
    	android:layout_height="wrap_content"
    	android:textSize="18sp"
    />
	<TextView
		android:id="@+id/input_tv_beginvolum"
		android:padding="8dp"
		android:gravity="center_horizontal"
		android:layout_width="0dp"
		android:layout_weight="2"
		android:layout_height="wrap_content"
		android:textSize="18sp"
		/>
    <TextView 
        android:id="@+id/inout_tv_endheight"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:layout_width="0dp"
        android:layout_weight="2"
    	android:layout_height="wrap_content"
    	android:textSize="18sp"
    />
	<TextView
		android:id="@+id/inout_tv_wen_du"
		android:padding="8dp"
		android:gravity="center_horizontal"
		android:layout_width="0dp"
		android:layout_weight="2"
		android:layout_height="wrap_content"
		android:textSize="18sp"
		/>
    <TextView 
        android:id="@+id/inout_tv_zhiliangkg"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:layout_width="0dp"
        android:layout_weight="2"
    	android:layout_height="wrap_content"
    	android:textSize="18sp"
    />



</LinearLayout>
