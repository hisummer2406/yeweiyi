<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:custom="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:orientation="vertical"
    android:layout_height="match_parent">
    <include
        android:id="@+id/title_bar"
        layout="@layout/layout_title_bar2" />
    <LinearLayout
        android:id="@+id/oilcanset_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bar_set"
        android:background="#e0ffffff"
        android:clickable="true"
        android:focusable="true"
        android:orientation="vertical"
        android:focusableInTouchMode="true">
        <ScrollView
            android:layout_width="match_parent"
            android:layout_weight="1"
            android:layout_height="0dp">

            <TableLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <TableRow
                    android:layout_marginTop="@dimen/dp_42"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/tank_no"
                        android:textSize="@dimen/fontSize" />

                    <TextView
                        android:id="@+id/item_tv_oilid"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sansen_drop"
                        android:gravity="center_horizontal"
                        android:paddingTop="3dp"
                        android:text="0"
                        android:textSize="@dimen/fontSize" />
                    <TextView
                        android:id="@+id/item_tv_oilheight"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oilheight"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_oilheight"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:digits="0123456789"
                        android:gravity="center_horizontal"
                        android:imeOptions="actionDone"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />


                </TableRow>


                <TableRow
                    android:layout_marginTop="17dp"
                    android:gravity="center_horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/probe_no"
                        android:textSize="@dimen/fontSize" />
                    <TextView
                        android:id="@+id/item_tv_tanzhenID"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sansen_drop"
                        android:gravity="center_horizontal"
                        android:paddingTop="3dp"
                        android:text="0"
                        android:textSize="@dimen/fontSize" />

                    <TextView
                        android:id="@+id/item_tv_maxvolum"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/max_volume"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_maxvolum"
                        android:layout_height="wrap_content"
                        android:layout_width="100dp"
                        android:digits="0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:imeOptions="actionDone"
                        android:textSize="@dimen/fontSize" />
                </TableRow>
                <TableRow android:gravity="center_horizontal">

                    <TextView
                        android:id="@+id/item_tv_chuanGanQiLeng"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/chuan_gan_qi_leng"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_chuanGanQiLeng"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />
                    <TextView
                        android:id="@+id/item_tv_oilhheightalarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hheight_oil_alarm_value"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_oilhheightalarm"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />


                </TableRow>
                <TableRow android:gravity="center_horizontal"

                    >
                    <TextView
                        android:id="@+id/item_tv_guanType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oiltype"
                        android:textSize="@dimen/fontSize" />

                    <Spinner
                        android:id="@+id/item_sp_guanType"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sansen_drop"
                        android:gravity="center_horizontal"
                        android:paddingTop="5dp"
                        android:entries="@array/guan_type"
                        android:textSize="@dimen/fontSize" />

                    <TextView
                        android:id="@+id/item_tv_oilheightalarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height_oil_alarm_value"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_oilheightalarm"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:digits="-0123456789"
                        android:imeOptions="actionDone"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />


                </TableRow>
                <TableRow android:gravity="center_horizontal"

                    >
                    <TextView
                        android:id="@+id/item_tv_oiltype"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oiltype"
                        android:textSize="@dimen/fontSize" />

                    <TextView
                        android:id="@+id/item_sp_oiltype"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:background="@drawable/sansen_drop"
                        android:gravity="center_horizontal"
                        android:paddingTop="5dp"
                        android:textSize="@dimen/fontSize" />
                    <TextView
                        android:id="@+id/item_tv_oilllowalarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/llow_oil_alarm_value"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_oilllowalarm"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />



                </TableRow>
                <TableRow android:gravity="center_horizontal"
                    >
                    <TextView
                        android:id="@+id/item_tv_color"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oil_color"
                        android:textSize="@dimen/fontSize" />

                    <Button
                        android:id="@+id/item_but_color"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:text="@string/select_color"
                        android:textSize="@dimen/sp_16" />
                    <TextView
                        android:id="@+id/item_tv_oillowalarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/low_oil_alarm_value"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_oillowalarm"
                        android:layout_height="wrap_content"
                        android:digits="-0123456789"
                        android:imeOptions="actionDone"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />




                </TableRow>

                <TableRow android:gravity="center_horizontal">
                    <TextView
                        android:id="@+id/item_tv_oildensity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="介质密度"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_oildensity"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="0123456789."
                        android:gravity="center_horizontal"
                        android:inputType="numberDecimal|numberSigned"
                        android:textSize="@dimen/fontSize" />




                    <TextView
                        android:id="@+id/item_tv_waterheightalarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height_water_alarm_value"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_waterheightalarm"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />


                </TableRow>


                <TableRow android:gravity="center_horizontal"
                    >

                    <TextView
                        android:id="@+id/item_tv_oillevelcorrection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/oil_level_compensation"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_oillevelcorrection"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="numberSigned|number"
                        android:textSize="@dimen/sp_16" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="低水位报警"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText

                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />
                </TableRow>

                <TableRow android:gravity="center_horizontal"

                    >
                    <TextView
                        android:id="@+id/item_tv_waterlevlecorrection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/water_level_compensation"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_waterlevlecorrection"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />
                    <TextView
                        android:id="@+id/item_tv_tempheightalarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/height_temp_alarm_value"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_tempheightalarm"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />



                </TableRow>

                <TableRow android:gravity="center_horizontal"

                    >
                    <TextView
                        android:id="@+id/item_tv_tempercorrection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/temp_ompensation"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_tempercorrection"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />

                    <TextView
                        android:id="@+id/item_tv_templowalarm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/low_temp_alarm_value"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_templowalarm"
                        android:layout_height="wrap_content"
                        android:digits="-0123456789"
                        android:imeOptions="actionDone"
                        android:gravity="center_horizontal"
                        android:inputType="number"
                        android:textSize="@dimen/fontSize" />


                </TableRow>
                <TableRow android:gravity="center_horizontal"
                    android:visibility="gone"

                    >
                    <TextView
                        android:id="@+id/item_tv_densityvar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/density_change"
                        android:textSize="@dimen/fontSize" />

                    <android.support.v7.widget.AppCompatEditText
                        android:id="@+id/item_et_densityvar"
                        android:layout_width="@dimen/tankset_tv_size"
                        android:layout_height="wrap_content"
                        android:imeOptions="actionDone"
                        android:digits="-0123456789."
                        android:gravity="center_horizontal"
                        android:inputType="numberDecimal|numberSigned"
                        android:textSize="@dimen/fontSize" />



                </TableRow>
            </TableLayout>
        </ScrollView>
        <LinearLayout
            android:layout_marginBottom="@dimen/dp_60"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/ly_baoCunData"
                android:layout_marginRight="@dimen/dp_40"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:background="#0066A2"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/bc"/>
                <TextView
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_15"
                    android:layout_gravity="center"
                    android:textSize="@dimen/sp_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="保存数据"/>
            </LinearLayout>
            <LinearLayout
                android:id="@+id/ly_copyData"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:background="#0066A2"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/fz"/>
                <TextView
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_15"
                    android:layout_gravity="center"
                    android:textSize="@dimen/sp_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="复制到"/>
            </LinearLayout>
            <LinearLayout
                android:layout_marginLeft="@dimen/dp_40"
                android:layout_width="@dimen/dp_150"
                android:layout_height="wrap_content"
                android:background="#0066A2"
                android:id="@+id/ly_upper_page"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="horizontal">
                <ImageView
                    android:layout_gravity="center"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:src="@drawable/fh"/>
                <TextView
                    android:layout_marginTop="@dimen/dp_15"
                    android:layout_marginBottom="@dimen/dp_15"
                    android:layout_gravity="center"
                    android:textSize="@dimen/sp_20"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:text="返回上页"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>