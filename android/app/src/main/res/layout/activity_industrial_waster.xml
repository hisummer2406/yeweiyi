<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="com.xinchen.allInOne.ui.cSInStorage.IndustrialWasterModel" />
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />

        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.cSInStorage.IndustrialWasterModel" />
    </data>

    <LinearLayout
        android:background="@mipmap/login_bg"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context="com.xinchen.allInOne.ui.inStorageMange.IndustrialWasterActivity">
        <include layout="@layout/include_title"
            binding:backClick="@{viewModel.backClick}"
            binding:entrity="@{entrity}"
            />
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginTop="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            binding:itemBinding="@{viewModel.itemBinding}"
            binding:items="@{viewModel.observableList}"
            binding:layoutManager="@{LayoutManagers.grid(4)}"
            />
        <LinearLayout
            android:layout_marginTop="@dimen/dp_10dp"
            android:layout_marginBottom="@dimen/dp_20dp"
            android:layout_marginLeft="@dimen/dp_160dp"
            android:layout_marginRight="@dimen/dp_160dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button
                android:layout_margin="@dimen/dp_10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textSize="@dimen/sp_9"
                android:textColor="@color/white"
                android:layout_height="@dimen/dp_20dp"
                binding:onClickCommand="@{viewModel.homePage}"
                android:background="@drawable/selector_page_button02"
                android:text="首页"
                android:button="@null"/>
            <Button
                android:textSize="@dimen/sp_9"
                android:layout_margin="@dimen/dp_10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                binding:onClickCommand="@{viewModel.upPage}"
                android:gravity="center"
                android:textColor="@color/white"
                android:layout_height="@dimen/dp_20dp"
                android:background="@drawable/selector_page_button02"
                android:text="上一页"
                android:button="@null"/>
            <TextView
                android:textSize="@dimen/sp_9"
                android:layout_margin="@dimen/dp_10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/white"
                android:layout_height="@dimen/dp_20dp"
                android:background="@drawable/selector_page_button02"
                android:text="@{String.valueOf(viewModel.page)+'/'+String.valueOf(viewModel.totalPage)}" />
            <Button
                android:textSize="@dimen/sp_9"
                android:layout_margin="@dimen/dp_10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                binding:onClickCommand="@{viewModel.nextPage}"
                android:textColor="@color/white"
                android:layout_height="@dimen/dp_20dp"
                android:background="@drawable/selector_page_button02"
                android:text="下一页"
                android:button="@null"/>
            <Button
                android:textSize="@dimen/sp_9"
                android:layout_margin="@dimen/dp_10dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="@color/white"
                binding:onClickCommand="@{viewModel.lastPage}"
                android:layout_height="@dimen/dp_20dp"
                android:background="@drawable/selector_page_button02"
                android:text="尾页"
                android:button="@null"/>

        </LinearLayout>
    </LinearLayout>
</layout>