<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.xinchen.allInOne.ui.recycleModel.AddLabelListRecycleViewModel" />
        <import type="com.xinchen.allInOne.utils.TypeUtils"/>
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.recycleModel.AddLabelListRecycleViewModel" />

    </data>
 <!--android:background="@{viewModel.isBackground ?@color/color_2291FF :@color/transform }"-->
    <LinearLayout
        android:background="@{viewModel.isBackground ?@color/color_2291FF :@color/transform }"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:layout_height="@dimen/dp_26dp">
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.createTime}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />
      <!--  <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />-->
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.countryLianDanNo}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.lianDanNo}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.generatedWasteName}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.wasteName}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />


        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{viewModel.entity.wasteCode}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />
        <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:text="@{TypeUtils.StatusType(viewModel.entity.status)}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_8"
            />
        <LinearLayout
            android:layout_weight="1"
            android:layout_width="@dimen/dp_0dp"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <TextView
                binding:onClickCommand="@{viewModel.getview}"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="查看"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                binding:onClickCommand="@{viewModel.setVoid}"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="作废"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
        </LinearLayout>

    </LinearLayout>
</layout>