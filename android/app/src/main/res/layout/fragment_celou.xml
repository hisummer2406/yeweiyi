<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical" >

    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center_vertical"

            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/celou"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>
·
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bar_set"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:background="#e0ffffff"
        android:orientation="vertical" >

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" >

            <TableLayout
                android:id="@+id/celou_tablayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="3"
                android:paddingLeft="60dp"
                android:paddingTop="20dp" >

                <TableRow>

                    <CheckBox
                        android:id="@+id/celou_cb_1"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        />

                    <CheckBox
                        android:id="@+id/celou_cb_2"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                         />

                    <CheckBox
                        android:id="@+id/celou_cb_3"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        />

                    <CheckBox
                        android:id="@+id/celou_cb_4"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"

                         />
                </TableRow>

                <TableRow>

                    <CheckBox
                        android:id="@+id/celou_cb_5"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        />

                    <CheckBox
                        android:id="@+id/celou_cb_6"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        />

                    <CheckBox
                        android:id="@+id/celou_cb_7"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        />

                    <CheckBox
                        android:id="@+id/celou_cb_8"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        />
                </TableRow>

                <TableRow>

                    <CheckBox
                        android:id="@+id/celou_cb_9"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                         android:textSize="18sp"
                        />

                    <CheckBox
                        android:id="@+id/celou_cb_10"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                       />

                    <CheckBox
                        android:id="@+id/celou_cb_11"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        />

                    <CheckBox
                        android:id="@+id/celou_cb_12"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"

                        />
                </TableRow>

                <TableRow>

                    <CheckBox
                        android:id="@+id/celou_cb_13"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"

                        />

                    <CheckBox
                        android:id="@+id/celou_cb_14"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"

                        />

                    <CheckBox
                        android:id="@+id/celou_cb_15"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"

                        />

                    <CheckBox
                        android:id="@+id/celou_cb_16"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"

                        />
                </TableRow>

                <TableRow>

                    <CheckBox
                        android:id="@+id/celou_cb_all"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="18sp"
                        android:text="@string/all_check"/>
                </TableRow>
            </TableLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical" >

                <Button
                    android:id="@+id/celou_bt_begin"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/begin_celou"
                    android:background="@drawable/sansen_beginjiance_but_selector" />

                <Button
                    android:id="@+id/celou_bt_end"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="40dp"
                    android:text="@string/end_celou"
                    android:background="@drawable/sansen_endjiance_but_selector" />
            </LinearLayout>
        </LinearLayout>

        <ProgressBar
            android:id="@+id/celou_pb_progressbar"
            style="@style/progressBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/celou_tablayout"
            android:layout_margin="10dp"
            android:background="@drawable/shape_progressbar_bg"
            android:max="100"
            android:progress="0" />

        <TextView
            android:id="@+id/celou_tv_result"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_below="@id/celou_pb_progressbar"
            android:scrollbars="vertical"
            android:singleLine="false"
            android:text="@string/test_result"
            android:textSize="20sp" />
    </LinearLayout>

</RelativeLayout>