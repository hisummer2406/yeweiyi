<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="backClick"
            type="android.view.View.OnClickListener" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/dp_34dp"
        android:onClick="@{backClick}"
        android:background="@mipmap/status_bar"
        android:orientation="horizontal">
        <ImageView
            android:layout_width="@dimen/dp_20dp"
            android:layout_height="@dimen/dp_20dp"
            android:layout_marginLeft="@dimen/dp_13dp"
            android:src="@drawable/icon_back" />
        <TextView
            android:layout_width="@dimen/dp_100dp"
            android:layout_height="@dimen/dp_20dp"
            android:layout_marginLeft="@dimen/dp_3dp"
            android:gravity="center_vertical"
            android:text="返回"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_11" />
      <!--  android:text="@{viewModel.title}"-->
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@{entrity.title}"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_13" />


        <TextView
            android:layout_width="@dimen/dp_120dp"
            android:layout_height="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_13dp"
            android:gravity="end|center_vertical"
            android:text="@{entrity.time}"
            android:textColor="@color/white"
            android:textSize="@dimen/sp_10" />
    </LinearLayout>
</layout>