<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/detailcommitwork_tv_id"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/detailcommitwork_tv_jiezhi"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/detailcommitwork_tv_beginheight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/detailcommitwork_tv_beginvolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/detailcommitwork_tv_endheight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:textSize="18sp" />
    <TextView
        android:id="@+id/detailcommitwork_tv_endvolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/detailcommitwork_tv_shellvolume"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="2"
        android:padding="8dp"
        android:gravity="center_horizontal"
        android:textSize="18sp" />



    <TextView
        android:id="@+id/detailcommitwork_tv_shellweight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_weight="2"
        android:padding="8dp"
        android:textSize="18sp" />

</LinearLayout>