<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />
     <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.outStorageManage.OutStorageDetailViewModel" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical"
       >
        <include layout="@layout/include_title"
            binding:backClick="@{viewModel.backClick}"
            binding:entrity="@{entrity}"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:id="@+id/ly_tab01"/>

        <LinearLayout
            android:layout_marginTop="@dimen/dp_5dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:background="@drawable/rc_st_2291ff_2"
            android:layout_height="@dimen/dp_24dp">
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="标签号"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="入库重量"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="贮存设施名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="出库重量"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_9"
                />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            binding:itemBinding="@{viewModel.itemBinding}"
            binding:items="@{viewModel.observableList}"
            binding:layoutManager="@{LayoutManagers.linear()}" />
    </LinearLayout>
</layout>