<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF0F7"
    android:orientation="vertical">
    <include
        android:id="@+id/title_bar"
        layout="@layout/layout_title_bar2" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_below="@+id/bar_set"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_marginTop="@dimen/dp_40"
            android:id="@+id/left"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_500"
            android:background="@color/white"
            android:padding="@dimen/dp_51"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_28"
                android:text="配置 ThingsBoard 云平台连接地址与设备凭据"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <LinearLayout
                android:layout_marginTop="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_28"
                    android:textColor="@color/black"
                    android:text="Broker地址"/>
                <EditText
                    android:id="@+id/et_broker_host"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:inputType="textUri"
                    android:layout_width="@dimen/dp_400"
                    android:layout_height="@dimen/dp_52"
                    android:background="@drawable/shap_login_setpwd"
                    android:textSize="@dimen/sp_22"
                    android:hint="如 192.168.1.10"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_28"
                    android:textColor="@color/black"
                    android:text="端口"/>
                <EditText
                    android:id="@+id/et_broker_port"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:inputType="number"
                    android:maxLength="5"
                    android:layout_width="@dimen/dp_250"
                    android:layout_height="@dimen/dp_52"
                    android:background="@drawable/shap_login_setpwd"
                    android:textSize="@dimen/sp_22"
                    android:hint="如 1883"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_28"
                    android:textColor="@color/black"
                    android:text="设备ID"/>
                <EditText
                    android:id="@+id/et_device_id"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_400"
                    android:layout_height="@dimen/dp_52"
                    android:background="@drawable/shap_login_setpwd"
                    android:textSize="@dimen/sp_22"
                    android:hint="云平台设备注册页给出的 Device ID"/>
            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="@dimen/dp_150"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_28"
                    android:textColor="@color/black"
                    android:text="访问令牌"/>
                <EditText
                    android:id="@+id/et_access_token"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_400"
                    android:layout_height="@dimen/dp_52"
                    android:background="@drawable/shap_login_setpwd"
                    android:textSize="@dimen/sp_22"
                    android:hint="云平台设备注册页给出的 Access Token"/>
            </LinearLayout>

            <TextView
                android:id="@+id/tv_connection_status"
                android:layout_marginTop="@dimen/dp_20"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_22"
                android:textColor="#666666"
                android:text=""/>
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_marginRight="@dimen/dp_40"
            android:id="@+id/ly_saveData"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_width="@dimen/dp_150"
            android:layout_height="wrap_content"
            android:background="#0066A2"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bc"/>
            <TextView
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:layout_gravity="center"
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="保存数据"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ly_upper_page"
            android:layout_marginRight="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_width="@dimen/dp_150"
            android:layout_height="wrap_content"
            android:background="#0066A2"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/fh"/>
            <TextView
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:layout_gravity="center"
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="返回上页"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
