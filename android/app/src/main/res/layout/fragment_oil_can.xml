<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/oilcan_relative"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:id="@+id/tv_main_return"
        android:layout_marginLeft="@dimen/dp_43"
        android:layout_marginTop="@dimen/dp_83"
        android:layout_width="@dimen/dp_120"
        android:text="@string/back_page"
        android:gravity="center"
        android:textSize="@dimen/sp_24"
        android:textColor="@color/white"
        android:layout_height="@dimen/dp_78"
        android:background="@drawable/main_return"/>
    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/iv_back"
            android:layout_width="@dimen/dp_500"
            android:background="@drawable/max_oilcan"
            android:orientation="horizontal"
            android:layout_height="@dimen/dp_320"
            >
<!--            <ImageView-->
<!--                android:id="@+id/iv_back"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content"-->
<!--                android:layout_centerInParent="true"-->
<!--                android:src="@drawable/max_oilcan"-->
<!--                android:scaleType="fitXY" />-->
            <com.sansen.yeweiyi.view.CustomProgressView

                android:id="@+id/oilcan_view_progress"
                android:layout_width="@dimen/dp_82"
                android:layout_height="@dimen/dp_240"
                android:layout_marginLeft="@dimen/dp_110"
                android:layout_marginTop="@dimen/dp_58"
                tools:ignore="DuplicateIds" />
        </LinearLayout>


        <TableLayout
            android:layout_width="@dimen/dp_400"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingLeft="5dp"
            android:stretchColumns="1">

            <TableRow>

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_type"
                    android:visibility="gone"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_type"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/oil_type"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_marginLeft="@dimen/dp_16"
                    android:layout_marginRight="@dimen/dp_85"
                    android:layout_width="0dp"
                    android:background="@color/c033158"
                    android:layout_height="@dimen/dp_43"
                    android:layout_weight="1"
                    android:layout_gravity="center_vertical"
                    android:orientation="vertical">

                    <TextView

                        android:id="@+id/oilcan_tv_oiltype"
                        android:layout_width="match_parent"
                        android:textColor="@color/white"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:textSize="@dimen/sp_25" />
                </LinearLayout>
            </TableRow>
            <TableRow
                android:layout_marginTop="@dimen/dp_15"
                >

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_capacity"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_capacity"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/tank_total_capacity"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_tv_oilvolume"
                        android:layout_width="wrap_content"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:gravity="left"
                        android:text=""
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow>

            <TableRow
                 android:layout_marginTop="@dimen/dp_6"
                >

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_level"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_level"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/yewei"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_tv_oillevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:gravity="left"
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow>


            <TableRow
                 android:layout_marginTop="@dimen/dp_6">

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_volume"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_volume"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/rongji"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_tv_oilweight"
                        android:layout_width="wrap_content"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow
                >

            <TableRow
                 android:layout_marginTop="@dimen/dp_6">

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_empty"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_empty"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:text="@string/tank_empty_capacity"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_tv_oiladdible"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow>






            <TableRow

                 android:layout_marginTop="@dimen/dp_6">

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_density"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_density"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/tank_density"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/oilcan_tv_midu"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow>
            <TableRow
                android:layout_marginTop="@dimen/dp_6">

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_weight"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_weight"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/zhiliang"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/oilcan_tv_zhiliang"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow>
            <TableRow
                android:layout_marginTop="@dimen/dp_6">

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_waterlevel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_waterlevel"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/water_level"
                        android:textSize="@dimen/sp_24" /></LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/oilcan_tv_waterlevel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow>
            <TableRow
                android:layout_marginBottom="@dimen/dp_39"
                android:layout_marginTop="@dimen/dp_6">

                <LinearLayout
                    android:id="@+id/oilcan_label_wrap_temp"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/oilcan_label_temp"
                        android:gravity="right"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:layout_width="match_parent"
                        android:textColor="@color/black"
                        android:layout_height="wrap_content"
                        android:text="@string/temperature"
                        android:textSize="@dimen/sp_24" /></LinearLayout>
                <!-- 关注人数 -->

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="2"
                    android:orientation="vertical">

                    <TextView
                        android:textColor="@color/black"
                        android:id="@+id/oilcan_tv_temperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/sp_24" />
                </LinearLayout>
            </TableRow>


        </TableLayout>
    </LinearLayout>





    <TextView
        android:visibility="gone"
        android:id="@+id/oilcan_tv_tankno"
        android:layout_width="60dp"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginLeft="@dimen/tankno_tv_left"
        android:layout_marginTop="20dp"
        android:gravity="center"
        android:textSize="50sp"
        android:textStyle="bold" />
    <!--<com.sansen.yeweiyi.view.CustomProgressView
        android:visibility="gone"
        android:layout_alignLeft="@+id/oilcan_tv_tankno"
        android:id="@+id/oilcan_view_progress"
        android:layout_width="@dimen/dp_145"
        android:layout_height="@dimen/dp_312"
        android:layout_marginLeft="@dimen/dp_100"
        android:layout_marginTop="@dimen/custom_progress_margintop" />-->

</RelativeLayout>