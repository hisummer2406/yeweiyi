<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.cSInStorage.InboundWeightModel" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical">

        <include layout="@layout/include_title"
            binding:backClick="@{viewModel.backClick}"
            binding:entrity="@{entrity}"
            />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_90dp"
            android:orientation="horizontal"
            android:paddingBottom="@dimen/dp_10dp"
            android:paddingLeft="@dimen/dp_30dp"
            android:paddingRight="@dimen/dp_30dp">

            <LinearLayout
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rc_1357bc_11"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/dp_10dp"
                android:paddingBottom="@dimen/dp_15dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_12"
                        android:text="@{entrity.weight}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_12"
                        android:text="  kg" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1dp"
                    android:background="@drawable/bg_line"
                    android:layout_marginTop="@dimen/dp_4dp"
                    android:layout_marginLeft="@dimen/dp_20dp"
                    android:layout_marginRight="@dimen/dp_20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4dp"
                    android:text="毛 量"
                    android:textColor="@color/color_8ABDFF"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rc_1357bc_11"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/dp_10dp"
                android:layout_marginLeft="@dimen/dp_45dp"
                android:paddingBottom="@dimen/dp_15dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_12"
                        android:text="@{entrity.roughWeight}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_12"
                        android:text="  kg" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1dp"
                    android:background="@drawable/bg_line"
                    android:layout_marginTop="@dimen/dp_4dp"
                    android:layout_marginLeft="@dimen/dp_20dp"
                    android:layout_marginRight="@dimen/dp_20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4dp"
                    android:text="皮 重"
                    android:textColor="@color/color_8ABDFF"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rc_1357bc_11"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="@dimen/dp_10dp"
                android:layout_marginLeft="@dimen/dp_45dp"
                android:paddingBottom="@dimen/dp_15dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:focusable="@{viewModel.input}"
                    android:focusableInTouchMode="@{viewModel.input}"
                    android:orientation="horizontal">

                    <EditText
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:background="@null"
                        android:textSize="@dimen/sp_12"
                        android:focusable="@{viewModel.input}"
                        android:focusableInTouchMode="@{viewModel.input}"
                        android:digits="0123456789."
                        android:inputType="number"
                        binding:onFocusChangeCommand="@{viewModel.onFocusChangeCommand}"
                        android:text="@={entrity.suttle}" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/sp_12"
                        android:text="  kg" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/dp_1dp"
                    android:background="@drawable/bg_line"
                    android:layout_marginTop="@dimen/dp_4dp"
                    android:layout_marginLeft="@dimen/dp_20dp"
                    android:layout_marginRight="@dimen/dp_20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/dp_4dp"
                    android:text="净 重"
                    android:textColor="@color/color_8ABDFF"
                    android:textSize="@dimen/sp_11" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_marginLeft="@dimen/dp_30dp"
            android:layout_marginRight="@dimen/dp_30dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:background="@drawable/rc_gd_1357bc_4">
            <TextView
                android:layout_marginLeft="@dimen/dp_18dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="废物信息"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12"
                android:gravity="center_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35dp"
            android:layout_marginLeft="@dimen/dp_50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@{`废物废物类型:   ` +viewModel.wasterEntity.wasteName}"
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_8ABDFF"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@{`废物废物类型:   ` +viewModel.wasterEntity.wasteType}"
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_8ABDFF"/>
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="@{`废物代码:   ` +viewModel.wasterEntity.wasteCode}"
                android:textSize="@dimen/sp_10"
                android:textColor="@color/color_8ABDFF"/>

            <View
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"/>
        </LinearLayout>


        <LinearLayout
            android:layout_marginLeft="@dimen/dp_30dp"
            android:layout_marginRight="@dimen/dp_30dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:background="@drawable/rc_gd_1357bc_4">
            <TextView
                android:layout_marginLeft="@dimen/dp_18dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="贮存信息"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12"
                android:gravity="center_vertical"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_35dp"
            android:paddingLeft="@dimen/dp_50dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="@dimen/dp_25dp"
                android:orientation="horizontal"
                android:layout_weight="1.5">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="入库负责人："
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/white"/>


                <EditText
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_30dp"
                    android:layout_weight="1"
                    android:hint="请输入"
                    android:gravity="center_vertical"
                    android:textColorHint="@color/textColorHint"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_10"
                    android:text="@={viewModel.industryName}"
                    />

            </LinearLayout>
            <LinearLayout
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="@dimen/dp_25dp"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_weight="1">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="贮存设施："
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/white"/>

                <Spinner
                    android:id="@+id/sn_warehouse"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_30dp"
                    android:layout_weight="1"
                    android:background="@drawable/rc_1357bc_4"
                    android:entries="@{viewModel.warehouseList}"
                    android:popupBackground="@color/color_1357BC"
                    android:prompt="@string/choose_warehouse"
                    android:textSize="@dimen/sp_10"
                    android:theme="@style/warehouse_spinner" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="@dimen/dp_25dp"
                android:orientation="horizontal"
                android:paddingLeft="@dimen/dp_30dp"
                android:layout_weight="1">
                <TextView
                    android:gravity="center_vertical"
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="贮存库位："
                    android:textSize="@dimen/sp_10"
                    android:textColor="@color/white"/>

                <Spinner
                    android:id="@+id/sn_location"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/dp_30dp"
                    android:layout_weight="1"
                    android:background="@drawable/rc_1357bc_4"
                    android:entries="@{viewModel.locationList}"
                    android:popupBackground="@color/color_1357BC"
                    android:prompt="@string/choose_location"
                    android:textSize="@dimen/sp_10"
                    android:theme="@style/warehouse_spinner" />
            </LinearLayout>
            <View
                android:layout_width="@dimen/dp_20dp"
                android:layout_height="wrap_content" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/dp_10dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:layout_width="@dimen/dp_100dp"
                android:layout_height="@dimen/dp_24dp"
                android:text="去皮"
                binding:onClickCommand="@{viewModel.peel}"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@drawable/rc_2291ff_4"
                android:textSize="@dimen/sp_10" />
            <TextView
                android:layout_width="@dimen/dp_100dp"
                android:layout_height="@dimen/dp_24dp"
                android:text="清零"
                binding:onClickCommand="@{viewModel.reset}"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@drawable/rc_2291ff_4"
                android:layout_marginLeft="@dimen/dp_33dp"
                android:textSize="@dimen/sp_10" />

            <TextView
                android:layout_width="@dimen/dp_100dp"
                android:layout_height="@dimen/dp_24dp"
                android:layout_marginLeft="@dimen/dp_33dp"
                android:background="@drawable/rc_2291ff_4"
                android:gravity="center"
                android:text="入库"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_10"
                binding:onClickCommand="@{viewModel.inbound}" />
        </LinearLayout>
    </LinearLayout>
</layout>