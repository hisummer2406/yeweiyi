<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.warningRecord.WarningRecordViewModel" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:context="com.xinchen.allInOne.ui.label.LabelSearchActivity">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_83"
            binding:title="viewModel"
            layout="@layout/layout_title_bar2" />
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_marginLeft="@dimen/dp_10dp"
            android:layout_marginRight="@dimen/dp_10dp"
            android:background="#D3DAE1"
            android:layout_marginTop="@dimen/dp_10dp"
            android:gravity="center_vertical"
            android:layout_height="@dimen/dp_15dp">
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/bianhao"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_9"
                />
            <TextView

                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="@string/guanhao"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@string/baojingxinxi"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_9"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@string/baojingshijian"
                android:textColor="@color/black"
                android:textSize="@dimen/sp_9"
                />

        </LinearLayout>
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginLeft="@dimen/dp_10dp"
            android:layout_marginRight="@dimen/dp_10dp"
            android:layout_weight="1">
            <com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout
                android:id="@+id/twinklingRefreshLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                binding:tr_head_height="@dimen/dp_5dp"
                binding:tr_wave_height="@dimen/dp_5dp">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                binding:itemBinding="@{viewModel.itemBinding}"
                binding:items="@{viewModel.observableList}"
                binding:layoutManager="@{LayoutManagers.linear()}" />
            </com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textSize="@dimen/sp_12"
                android:text="没有更多内容"
                android:textColor="@color/white"
                android:visibility="@{viewModel.noContent}" />

        </RelativeLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center|bottom"
            android:orientation="horizontal">
            <LinearLayout
                android:layout_margin="@dimen/dp_10dp"
                android:layout_width="@dimen/dp_40dp"
                android:layout_height="@dimen/dp_15dp"
                android:background="#3B79F0"
                android:gravity="center"
                binding:onClickCommand="@{viewModel.btn_DaoChu}"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@mipmap/dc"/>
                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="导出数据"

                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_15"
                    />
            </LinearLayout>
            <LinearLayout
                android:layout_margin="@dimen/dp_10dp"
                android:layout_width="@dimen/dp_40dp"
                android:layout_height="@dimen/dp_15dp"
                android:background="#0066A2"
                android:gravity="center"
                binding:onClickCommand="@{viewModel.btn_fanHui}"
                android:orientation="horizontal">
                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@mipmap/fh"/>
                <TextView

                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:text="返回首页"

                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_15"
                    />
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</layout>