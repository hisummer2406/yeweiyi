<?xml version="1.0" encoding="utf-8"?>


<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.cSOutStorage.ScanOutboundFragmentModel" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical"
        android:layout_height="match_parent"
        android:paddingLeft="@dimen/dp_20dp"
        android:paddingRight="@dimen/dp_20dp"
        android:paddingTop="@dimen/dp_10dp"
        tools:context="com.xinchen.allInOne.ui.outStorageMange.OutboundListActivity">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_24dp"
            android:background="@drawable/rc_gd_1357bc_4">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:text="扫描二维码"
                android:paddingLeft="@dimen/dp_18dp"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_9"
                android:gravity="center_vertical"/>
            <TextView
                android:layout_marginLeft="@dimen/dp_20dp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:textSize="@dimen/sp_7"
                android:textColor="@color/white"
                android:gravity="center_vertical"
                android:textColorHint="@color/white"
                android:hint="请扫描二维码文本"
                android:layout_height="match_parent"
                android:text="@={viewModel.qrcode}"
                />
            <LinearLayout
                android:layout_width="@dimen/dp_100dp"
                android:layout_height="@dimen/dp_24dp"
                android:orientation="horizontal"
                binding:onClickCommand="@{viewModel.queryData}"
                android:background="@drawable/rc_2291ff_4"
                android:gravity="center"
                >
                <ImageView
                    android:layout_width="@dimen/dp_10dp"
                    android:layout_height="@dimen/dp_10dp"
                    android:src="@mipmap/icon_scan"/>
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="扫描二维码"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:layout_marginLeft="@dimen/dp_7dp"
                    android:textSize="@dimen/sp_9" />
            </LinearLayout>
            
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:background="@drawable/bg_top_2291ff_corner4"
            android:layout_marginTop="@dimen/dp_16dp"
            android:gravity="center_vertical"
            android:layout_height="@dimen/dp_23dp">
           <!-- <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="标签编码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />-->
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="数字识别码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物重量（kg）"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物类别"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物代码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="入库时间"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8"
                />
        </LinearLayout>
        <com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout
            android:id="@+id/twinklingRefreshLayout"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            binding:onLoadMoreCommand="@{viewModel.onLoadMoreCommand}"
            binding:onRefreshCommand="@{viewModel.onRefreshCommand}"
            binding:tr_head_height="80dp"
            binding:tr_wave_height="80dp">
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                binding:itemBinding="@{viewModel.itemBinding}"
                binding:items="@{viewModel.observableList}"
                binding:layoutManager="@{LayoutManagers.linear()}"
                />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="没有更多内容"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12"
                android:visibility="@{viewModel.noContent}" />

        </com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_30dp"
            android:gravity="center"
            android:orientation="horizontal">
            <TextView
                android:layout_width="@dimen/dp_120dp"
                android:layout_height="@dimen/dp_24dp"
                android:text="自行利用处置出库"
                binding:onClickCommand="@{viewModel.selfOutbound}"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@drawable/rc_2291ff_4"
                android:textSize="@dimen/sp_8" />
            <TextView
                android:layout_width="@dimen/dp_120dp"
                android:layout_height="@dimen/dp_24dp"
                android:text="委外出库"
                binding:onClickCommand="@{viewModel.entrustOutbound}"
                android:gravity="center"
                android:textColor="@color/white"
                android:background="@drawable/rc_2291ff_4"
                android:layout_marginLeft="@dimen/dp_53dp"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>
    </LinearLayout>
</layout>