<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF0F7"
    android:orientation="vertical">

    <include
        android:id="@+id/title_bar"
        layout="@layout/layout_title_bar2" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginLeft="@dimen/dp_88"
        android:layout_marginTop="@dimen/dp_50"
        android:layout_marginRight="@dimen/dp_88"
        android:layout_marginBottom="@dimen/dp_50"
        android:layout_weight="1"
        android:background="#f0f4ff"
        android:orientation="vertical"
        android:padding="40dp">

        <!-- 报警记录导出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="报警记录导出"
                android:textColor="#222222"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_alarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:checked="true"
                android:textOff="否"
                android:textOn="是"
                android:thumbTextPadding="12dp" />
        </LinearLayout>

        <!-- 分割间距 -->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 出库记录导出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="出库记录导出"
                android:textColor="#222222"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_out"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:checked="false"
                android:textOff="否"
                android:textOn="是"
                android:thumbTextPadding="12dp" />
        </LinearLayout>
        <!--        <Switch-->
        <!--            android:id="@+id/sw_out"-->
        <!--            android:layout_width="wrap_content"-->
        <!--            android:layout_height="wrap_content"-->
        <!--            android:checked="false"-->
        <!--            android:textOff="否"-->
        <!--            android:textOn="是"-->
        <!--            android:thumb="@drawable/switch_thumb"-->
        <!--            android:thumbTextPadding="12dp"-->
        <!--            android:track="@drawable/switch_track_selector" />-->
        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 入库记录导出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="入库记录导出"
                android:textColor="#222222"
                android:textSize="20sp" />


            <Switch
                android:id="@+id/sw_in"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:checked="true"
                android:textOff="否"
                android:textOn="是"
                android:thumbTextPadding="12dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 交班记录导出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="交班记录导出"
                android:textColor="#222222"
                android:textSize="20sp" />

            <Switch
                android:id="@+id/sw_shift"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:checked="true"
                android:textOff="否"
                android:textOn="是"
                android:thumbTextPadding="12dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="24dp" />

        <!-- 库存记录导出 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="库存记录导出"
                android:textColor="#222222"
                android:textSize="20sp" />


            <Switch
                android:id="@+id/sw_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="@dimen/dp_15"
                android:checked="true"
                android:textOff="否"
                android:textOn="是"
                android:thumbTextPadding="12dp" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:layout_marginBottom="@dimen/dp_60"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_width="@dimen/dp_150"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/dp_20"
            android:id="@+id/ly_upper_page"
            android:layout_marginRight="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_20"
            android:background="#0066A2"
            android:gravity="center"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:src="@drawable/fh" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:text="返回上页"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_20" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>