<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:text="@string/aboutus"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bar_set"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:background="#e0ffffff">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal">
            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">
                <android.support.v7.widget.RecyclerView
                    android:id="@+id/min_cur_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    >
                </android.support.v7.widget.RecyclerView>
                <android.support.v7.widget.AppCompatButton
                    android:id="@+id/min_default"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:layout_below="@id/min_cur_list"
                    android:layout_marginTop="100dp"
                    android:textSize="20sp"
                    android:text="@string/recollection"
                    />
            </RelativeLayout>

            <android.support.v7.widget.RecyclerView
                android:id="@+id/min_select_list"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                ></android.support.v7.widget.RecyclerView>
        </LinearLayout>

    </RelativeLayout>
</LinearLayout>