<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <import type="com.sansen.yeweiyi.bean.SerialPortEntrity" />
        <variable
            name="viewModel"
            type="com.sansen.yeweiyi.bean.SerialPortEntrity" />

    </data>
<!-- 背景（sansen_top_title）和中间 logo（bar_iv_center_logo）分开：换品牌 logo 只换中间这张图，背景不动 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_80"
    android:background="@drawable/sansen_top_title">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal" >

    <!-- 左侧ICON -->

    <ImageView
        android:id="@+id/bar_iv_icon"
        android:layout_width="@dimen/dp_296"
        android:layout_height="@dimen/dp_35"
        android:scaleType="fitStart"
        android:background="@drawable/sansen_logo"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="30dp"/>

    <!-- 连点 7 次进厂家设置：高度铺满标题栏、右侧加 padding 放大点击区域，文字位置不变 -->
    <TextView
        android:id="@+id/bar_tv_version"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:paddingHorizontal="@dimen/dp_5"
        android:textColor="@android:color/black"
        android:textSize="@dimen/sp_16"
        android:hint="v1.0.0-A"/>
    <TextView
        android:id="@+id/bar_tv_title"
        style="@style/style_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_weight="8"
        android:drawablePadding="5dp"
        android:gravity="center"
        android:textColor="@color/red"
        android:singleLine="true"
        />


    <!-- [不可达-2026-09-21] bar_tv_filter 到下面 bar_tv_unlogin 这几个 View 恒为 gone，
         BaseActivity.java 里给它们赋值/切换可见性的代码整段被注释掉（西语翻译覆盖率核查时发现）。
         filter/save_oilcan(下面注释里那处引用本身就在 XML 注释内，不是真实资源引用)/Log_out
         这几个字符串资源不用优先翻。 -->
    <TextView
        android:visibility="gone"
        android:id="@+id/bar_tv_filter"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="2"
        android:paddingTop="12dp"
        android:background="@android:color/transparent"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"
        android:textSize="20sp"
         />

    <TextView
        android:visibility="gone"
        android:id="@+id/bar_tv_right"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:paddingTop="12dp"
        android:layout_weight="8"
        android:background="@android:color/transparent"
        android:ellipsize="end"
        android:gravity="center"
        android:singleLine="true"

        android:textSize="20sp" />
    <!-- 登录图标 -->

    <ImageButton
        android:visibility="gone"
        android:id="@+id/bar_imbut_left"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1.5"
        android:background="@android:color/transparent"
        android:paddingTop="12dp"
        android:src="@drawable/sansen_user_logo" />

    <TextView
        android:visibility="gone"
        android:id="@+id/bar_tv_left"
        android:layout_width="wrap_content"
        android:layout_height="50dp"
        android:background="@android:color/transparent"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:singleLine="true"
        android:paddingRight="30dp"
        android:textSize="20sp" />

    <TextView
        android:visibility="gone"
        android:id="@+id/bar_tv_unlogin"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:layout_weight="4"
        android:paddingTop="12dp"
        android:paddingRight="18dp"
        android:textSize="20sp" />
    <ImageView
        android:layout_gravity="center"
        android:layout_toLeftOf="@+id/main_time"
        android:id="@+id/iv_time"
        android:layout_width="@dimen/dp_30"
        android:layout_height="match_parent"
        android:layout_marginRight="@dimen/dp_5"
        android:src="@drawable/sj_1"
        />
    <TextView
        android:layout_marginRight="@dimen/dp_20"
        android:id="@+id/bar_tv_time"
        android:layout_width="wrap_content"
        android:gravity="center"
        android:layout_height="match_parent"
        android:hint="20260122"
        android:textColor="@color/black"
        android:text="@{viewModel.time}"
        android:paddingRight="@dimen/sp_21"
        android:textSize="@dimen/sp_24" />
</LinearLayout>

    <!-- 中间 logo：高度跟随标题栏，按原图比例居中 -->
    <ImageView
        android:id="@+id/bar_iv_center_logo"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/top_title_logo" />
</FrameLayout>
</layout>
