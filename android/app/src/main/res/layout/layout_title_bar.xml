<?xml version="1.0" encoding="utf-8"?>
<layout>

    <data>
        <import type="com.xinchen.allInOne.ui.main_activity.MainViewModel" />
        <variable
            name="entity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
        <variable
            name="title"
            type="com.xinchen.allInOne.ui.main_activity.MainViewModel" />

    </data>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/title_bar"
    android:layout_width="match_parent"
    android:layout_height="@dimen/dp_83"
    android:background="@mipmap/main_title"
    android:orientation="horizontal" >
    <ImageView
        android:id="@+id/bar_iv_icon"
        android:layout_width="@dimen/dp_247"
        android:layout_height="@dimen/dp_33"
        android:scaleType="fitStart"
        android:background="@mipmap/zt"
        android:layout_gravity="center_vertical"
        android:layout_marginLeft="@dimen/dp_30"/>

    <TextView
        android:layout_width="@dimen/dp_0"
        android:layout_height="match_parent"
        android:layout_weight="1"/>
    <ImageView
        android:layout_width="@dimen/dp_30"
        android:layout_height="match_parent"
        android:src="@mipmap/sj_1"
        />


    <TextView
        android:id="@+id/main_time"
        android:gravity="center"
        android:layout_marginRight="@dimen/dp_30"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:textColor="@color/main_font_tag"
        android:text="@{entity.time}"
        android:textSize="@dimen/sp_20" />
</LinearLayout>
</layout>