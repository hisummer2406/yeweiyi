<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    >
	<LinearLayout
		android:id="@+id/bar_set"
	    android:layout_width="match_parent"
	    android:layout_height="wrap_content"
	    android:orientation="horizontal"
	    android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
    	android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2">
        <ImageView
			android:id="@+id/bar_iv_icon"
			android:layout_width="30dp"
			android:layout_height="30dp"
			android:layout_marginLeft="10dp"
			android:layout_marginRight="10dp"
			android:layout_gravity="center_vertical"
			/>
        <TextView 
             android:layout_width="wrap_content"
             android:layout_height="wrap_content"
             android:text="@string/oiltype_custom"
             android:textColor="@android:color/white"
             android:textSize="18sp"
             android:layout_gravity="center_vertical"
         />
	</LinearLayout>
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:layout_below="@id/bar_set"
		android:layout_marginBottom="10dp"
		android:layout_marginLeft="58.5dp"
		android:layout_marginRight="59dp"
		android:background="#e0ffffff"
		android:orientation="vertical"
		android:focusableInTouchMode="true"
		android:clickable="true"
		android:focusable="true"
		>
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:textSize="20sp"
			android:layout_marginRight="30dp"
			android:gravity="right"
			android:layout_marginTop="10dp"
			android:text="@string/space_del"
			/>

		<android.support.v7.widget.RecyclerView
			android:layout_width="match_parent"
			android:layout_height="match_parent"
			android:id="@+id/oiltype_custom"
			android:layout_marginTop="20dp">
		</android.support.v7.widget.RecyclerView>
	</LinearLayout>
</RelativeLayout>