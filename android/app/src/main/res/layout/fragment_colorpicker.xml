<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_gravity="center_horizontal"
    android:background="@android:color/black"
    >

    <com.sansen.yeweiyi.view.colorpicker.ColorPicker
        android:id="@+id/color_picker"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content" 
        android:layout_centerVertical="true"
        android:layout_marginLeft="100dp"/>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent" 
        android:orientation="vertical" 
        android:gravity="center"
        android:layout_toRightOf="@id/color_picker"
       >

        <com.sansen.yeweiyi.view.colorpicker.SVBar
            android:id="@+id/color_svbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

        <com.sansen.yeweiyi.view.colorpicker.OpacityBar
            android:id="@+id/color_opacitybar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" 
             android:layout_marginTop="10dp"/>

        <com.sansen.yeweiyi.view.colorpicker.SaturationBar
            android:id="@+id/color_saturationbar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" 
             android:layout_marginTop="10dp"/>

        <com.sansen.yeweiyi.view.colorpicker.ValueBar
            android:id="@+id/color_valuebar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" 
             android:layout_marginTop="10dp"/>

        <TextView
            android:id="@+id/color_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/save_color"
            android:textSize="30sp" 
             android:layout_marginTop="10dp"/>
    </LinearLayout>

</RelativeLayout>