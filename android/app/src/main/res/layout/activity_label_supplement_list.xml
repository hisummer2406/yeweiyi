<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto">
    <data>
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />

        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />

        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.labelSupplement.LabelSupplementListModel" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical"
        >
        <include layout="@layout/include_title"
            binding:backClick="@{viewModel.backClick}"
            binding:entrity="@{entrity}"
            />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_24dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:orientation="horizontal"
            android:background="@drawable/rc_gd_1357bc_4">
            <LinearLayout
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:layout_marginLeft="@dimen/dp_5dp"
                android:layout_marginRight="@dimen/dp_10dp"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:text="联单编号："
                    android:textColor="#ffffffff"
                    android:textSize="@dimen/sp_8"
                    />

                <EditText
                    android:layout_width="@dimen/dp_120dp"
                    android:background="@null"
                    android:layout_height="match_parent"
                    android:layout_marginLeft="@dimen/dp_5dp"
                    android:maxLines="2"
                    android:hint="请输入国家或省内联单编号"
                    android:textSize="@dimen/sp_8"
                    android:textColorHint="@color/color_C9C9C9"
                    android:textColor="@color/white"
                    android:layout_weight="1"
                    android:text="@={viewModel.liandanNo}" />


            </LinearLayout>
            <LinearLayout
                binding:onClickCommand="@{viewModel.queryCommand}"
                android:paddingRight="@dimen/dp_10dp"
                android:paddingLeft="@dimen/dp_10dp"
                android:layout_width="@dimen/dp_60dp"
                android:layout_height="@dimen/dp_24dp"
                android:orientation="horizontal"
                android:background="@drawable/rc_2291ff_4"
                android:gravity="center"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="查询"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_8" />
            </LinearLayout>
            <LinearLayout
                android:layout_marginLeft="@dimen/dp_20dp"
                binding:onClickCommand="@{viewModel.resetData}"
                android:paddingRight="@dimen/dp_10dp"
                android:paddingLeft="@dimen/dp_10dp"
                android:layout_marginRight="@dimen/dp_10dp"
                android:layout_width="@dimen/dp_60dp"
                android:layout_height="@dimen/dp_24dp"
                android:orientation="horizontal"
                android:background="@drawable/rc_2291ff_4"
                android:gravity="center"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="置空"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_8" />
            </LinearLayout>
            <View
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"/>
            <LinearLayout
                binding:onClickCommand="@{viewModel.AddLabelActivity}"
                android:paddingRight="@dimen/dp_10dp"
                android:paddingLeft="@dimen/dp_10dp"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/dp_24dp"
                android:orientation="horizontal"
                android:background="@drawable/rc_2291ff_4"
                android:gravity="center"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="新增补录"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sp_8" />
            </LinearLayout>

        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_23dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:background="@drawable/bg_top_2291ff_corner4"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="补录时间"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_marginLeft="@dimen/dp_15dp"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="国家联单编号"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="省内联单编号"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="补录前废物名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="补录后废物名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="废物代码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="状态"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />
            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="操作"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>

        <com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout
            android:id="@+id/twinklingRefreshLayout"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            binding:onLoadMoreCommand="@{viewModel.onLoadMoreCommand}"
            binding:onRefreshCommand="@{viewModel.onRefreshCommand}"
            binding:tr_head_height="80dp"
            binding:tr_wave_height="80dp">

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                binding:itemBinding="@{viewModel.itemBinding}"
                binding:items="@{viewModel.observableList}"
                binding:layoutManager="@{LayoutManagers.linear()}" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="没有更多内容"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_12"
                android:visibility="@{viewModel.noContent}" />

        </com.lcodecore.tkrefreshlayout.TwinklingRefreshLayout>

    </LinearLayout>
</layout>