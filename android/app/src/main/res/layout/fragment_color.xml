<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingBottom="@dimen/dp_100"
    android:paddingTop="@dimen/dp_100"
    android:paddingLeft="@dimen/dp_200"
    android:paddingRight="@dimen/dp_200"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center_vertical"

            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:text="@string/color_picker"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/bar_set"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:background="#e0ffffff">

        <GridView
            android:id="@+id/color_gridview_color"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:horizontalSpacing="1dp"
            android:verticalSpacing="1dp"
            android:gravity="center"
            android:listSelector="@drawable/list_item_bg"
            android:numColumns="3"
            android:paddingLeft="1dp"
            android:stretchMode="columnWidth"></GridView>
    </LinearLayout>


</RelativeLayout>