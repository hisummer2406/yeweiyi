<?xml version="1.0" encoding="utf-8"?>
<layout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools">

    <data>
        <import type="com.xinchen.allInOne.utils.TypeUtils"/>
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />

        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.inStorageMange.InStorageDetailViewModel" />
        <variable
            name="entrity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />
    </data>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@mipmap/login_bg"
        android:orientation="vertical"
        tools:context="com.xinchen.allInOne.ui.label.LabelSearchActivity">
        <include layout="@layout/include_title"
            binding:backClick="@{viewModel.backClick}"
            binding:entrity="@{entrity}"
            />
        <LinearLayout
            android:layout_marginLeft="@dimen/dp_40dp"
            android:layout_marginRight="@dimen/dp_40dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="@dimen/dp_33dp">
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="入库时间："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.createdAt}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="联单编号："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.liandanno}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="废物名称："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.wasteName}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="废物类别："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.wasteType}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />

        </LinearLayout>
        <LinearLayout
            android:layout_marginLeft="@dimen/dp_40dp"
            android:layout_marginRight="@dimen/dp_40dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="@dimen/dp_33dp">
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="废物代码："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.wasteCode}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="利用处置方式："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.czname}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="入库数量："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{String.valueOf(viewModel.labelCount)}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="贮存设施名称："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.warehouseName}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />

        </LinearLayout>
        <LinearLayout
            android:layout_marginLeft="@dimen/dp_40dp"
            android:layout_marginRight="@dimen/dp_40dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:layout_height="@dimen/dp_33dp">
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="贮存设施类型："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{TypeUtils.CangKeType(viewModel.Entity.type)}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />

            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="入库总重量："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{String.valueOf(viewModel.labelWeight)}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_80dp"
                android:layout_height="@dimen/dp_33dp"
                android:text="入库批次号："
                android:gravity="center_vertical"
                android:textColor="@color/white"
                android:textSize="@dimen/sp_7"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="@dimen/dp_33dp"
                android:text="@{viewModel.Entity.rukuPici}"
                android:gravity="center_vertical"
                android:textColor="#ff8abdff"
                android:textSize="@dimen/sp_8"
                />
            <TextView
                android:layout_width="@dimen/dp_0dp"
                android:layout_height="@dimen/dp_33dp"
                android:layout_weight="4.7"/>
        </LinearLayout>
        <LinearLayout
            android:layout_marginTop="@dimen/dp_5dp"
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:background="@drawable/rc_st_2291ff_2"
            android:layout_height="@dimen/dp_24dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:text="数字识别码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_7" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="入库重量"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_7"
                />
        </LinearLayout>
        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginLeft="@dimen/dp_20dp"
            android:layout_marginRight="@dimen/dp_20dp"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            binding:itemBinding="@{viewModel.itemBinding}"
            binding:items="@{viewModel.observableList}"
            binding:layoutManager="@{LayoutManagers.linear()}" />
    </LinearLayout>
</layout>