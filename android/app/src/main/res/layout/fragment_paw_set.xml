<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EDF0F7"
    android:orientation="vertical">
    <include
        android:id="@+id/title_bar"
        layout="@layout/layout_title_bar2" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_below="@+id/bar_set"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginBottom="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_marginTop="@dimen/dp_40"
            android:id="@+id/left"
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_284"
            android:background="@color/white"
            android:padding="@dimen/dp_51"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tv_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/sp_28"
                android:text="@string/set_admin_password_3"
                android:textStyle="bold"
                android:textColor="@color/black"/>

            <LinearLayout
                android:layout_marginTop="@dimen/dp_10"
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_0"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:layout_weight="1">
                <TextView
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_28"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/login_password_hint"
                    />
                <EditText
                    android:id="@+id/et_psw"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:inputType="number"
                    android:layout_width="@dimen/dp_250"
                    android:layout_height="@dimen/dp_52"
                    android:background="@drawable/shap_login_setpwd"
                    android:textSize="@dimen/sp_22"
                    android:hint="@string/login_tv_password"/>
                <TextView
                    android:layout_marginLeft="@dimen/dp_30"
                    android:layout_marginTop="@dimen/dp_2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/sp_28"
                    android:paddingLeft="@dimen/dp_10"
                    android:textColor="@color/black"
                    android:text="@string/confirm_password"
                    />
                <EditText
                    android:id="@+id/et_confirm_psw"
                    android:layout_marginLeft="@dimen/dp_20"
                    android:layout_width="@dimen/dp_250"
                    android:inputType="number"
                    android:layout_height="@dimen/dp_52"
                    android:background="@drawable/shap_login_setpwd"
                    android:textSize="@dimen/sp_22"
                    android:hint="@string/psdset_hit_againnewpsd"/>
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>
    <android.support.v7.widget.AppCompatButton
       android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:textSize="@dimen/fontSize" />
    <LinearLayout
        android:layout_marginBottom="@dimen/dp_60"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="horizontal">
        <LinearLayout
            android:layout_marginRight="@dimen/dp_40"
            android:id="@+id/ly_saveData"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_width="wrap_content"
            android:minWidth="@dimen/dp_150"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:layout_height="wrap_content"
            android:background="#0066A2"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/bc"/>
            <TextView
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:layout_gravity="center"
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="@string/save_data"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/ly_upper_page"
            android:layout_marginRight="@dimen/dp_40"
            android:layout_marginBottom="@dimen/dp_20"
            android:layout_marginTop="@dimen/dp_20"
            android:layout_width="wrap_content"
            android:minWidth="@dimen/dp_150"
            android:paddingLeft="@dimen/dp_6"
            android:paddingRight="@dimen/dp_6"
            android:layout_height="wrap_content"
            android:background="#0066A2"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:layout_gravity="center"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/fh"/>
            <TextView
                android:layout_marginTop="@dimen/dp_15"
                android:layout_marginBottom="@dimen/dp_15"
                android:layout_gravity="center"
                android:textSize="@dimen/sp_20"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:text="@string/previous_page"/>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>