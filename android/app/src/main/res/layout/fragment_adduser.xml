<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent" >

    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2"
        android:orientation="horizontal"
        >
        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_gravity="center_vertical"
            />
        <TextView 
             android:id="@+id/fragmet_title"
             android:layout_width="wrap_content"
             android:layout_height="match_parent"
             android:text="@string/user_set"
             android:textColor="@android:color/white"
             android:textSize="18sp"
             android:layout_gravity="center_vertical"
         />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bar_set"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:background="#e0ffffff"
        android:orientation="vertical" >

        <android.support.v7.widget.AppCompatEditText
            android:id="@+id/adduser_et_username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15dp"
            android:layout_marginRight="15dp"
            android:layout_marginBottom="15dp"
            android:layout_marginTop="50dp"
            android:hint="@string/adduser_hint_userinfo"
            android:inputType="textNoSuggestions" />

        <android.support.v7.widget.AppCompatEditText
            android:id="@+id/adduser_et_psd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:layout_below="@id/adduser_et_username"
            android:layout_margin="15dp"
            android:hint="@string/adduser_hint_psd"
            />

        <android.support.v7.widget.AppCompatEditText
            android:id="@+id/adduser_et_againpsd"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPassword"
            android:layout_below="@id/adduser_et_psd"
            android:layout_margin="15dp"
            android:hint="@string/psdset_hit_againnewpsd"
             />

        <Button
            android:id="@+id/adduser_but_confirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/adduser_et_againpsd"
            android:text="@string/confirm" />
    </LinearLayout>

</RelativeLayout>