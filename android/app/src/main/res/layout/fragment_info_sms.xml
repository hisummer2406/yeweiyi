<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/bar_set"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/sansen_record_info_bar_2"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/bar_iv_icon"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_gravity="center_vertical"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp" />

        <TextView
            android:id="@+id/fragmet_title"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="center_vertical"
            android:text="@string/user_set"
            android:textColor="@android:color/white"
            android:textSize="18sp" />
    </LinearLayout>

    <RelativeLayout
        android:id="@+id/left"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/bar_set"
        android:layout_marginBottom="10dp"
        android:layout_marginLeft="58.5dp"
        android:layout_marginRight="59dp"
        android:background="#e0ffffff"
        android:orientation="vertical">

        <android.support.v7.widget.AppCompatEditText
        android:id="@+id/info_sms_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="短信标识(确定后无法修改)" />

        <android.support.v7.widget.AppCompatEditText
        android:id="@+id/info_sms_name"
        android:layout_below="@id/info_sms_id"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="模版名字" />

        <android.support.v7.widget.AppCompatEditText
            android:id="@+id/info_sms_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/info_sms_name"
            android:hint="短信编辑区" />
        <LinearLayout
            android:id="@+id/line1"
            android:layout_below="@id/info_sms_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_id"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="罐号"
                />
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_type"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="油品"
                />
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_oilheight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="油高"
                />
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_waterheight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="水高"
                />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/line2"
            android:layout_below="@id/line1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_volume"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="存油体积"
                />
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_weight"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="存油重量"
                />
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_addvolume"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="空油量"
                />
            <android.support.v7.widget.AppCompatButton
                android:id="@+id/sms_info_temp"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="温度"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/line3"
            android:layout_below="@id/line2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <Button
                android:id="@+id/sms_info_save"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="保存"/>
            <Button
                android:id="@+id/sms_info_clear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="清空内容"/>
        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>