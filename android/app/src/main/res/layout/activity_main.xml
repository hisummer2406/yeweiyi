<?xml version="1.0" encoding="utf-8"?>

<layout
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.xinchen.allInOne.ui.main_activity.MainViewModel" />
        <variable
            name="entity"
            type="com.xinchen.allInOne.entity.SerialPortEntrity" />


        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.main_activity.MainViewModel" />

        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />

        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LineManagers" />
    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
        <include
            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_83"
            binding:title="viewModel"
            layout="@layout/layout_title_bar" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#002C47"
            android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:background="@drawable/rc_white_2"
                    android:layout_width="match_parent"
                    android:padding="@dimen/dp_10dp"
                    android:gravity="center"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_gravity="center"
                    binding:itemBinding="@{viewModel.itemBinding}"
                    binding:items="@{viewModel.observableFunList}"
                    binding:layoutManager="@{LayoutManagers.grid(3)}" />
            <include
                android:layout_width="match_parent"
                android:layout_height="@dimen/dp_60"
                app:viewModel="@{viewModel}"
                layout="@layout/layout_bottom_bar" />
        </LinearLayout>


    </LinearLayout>


</layout>