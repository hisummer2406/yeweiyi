<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:tools="http://schemas.android.com/tools"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:binding="http://schemas.android.com/apk/res-auto">

    <data>

        <import type="com.xinchen.allInOne.ui.recycleModel.OutboundBatchListRecycleViewModel" />
        <import type="com.xinchen.allInOne.utils.StringUtil"/>
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.recycleModel.OutboundBatchListRecycleViewModel" />

    </data>

    <LinearLayout
        android:id="@+id/ly_inStorageBackground"
        android:layout_width="match_parent"
        android:orientation="horizontal"
        android:background="@{viewModel.isBackground ?@color/color_2291FF :@color/transform}"
        android:layout_height="@dimen/dp_23dp">
        <ImageView
            binding:onClickCommand="@{viewModel.itemClick}"
            app:setSelected="@{viewModel.entity.isSelect}"
            android:id="@+id/iv_status"
            android:layout_width="@dimen/dp_15dp"
            android:layout_height="@dimen/dp_15dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/select_chebox"/>
      <!--  <TextView
            android:gravity="center"
            android:layout_width="0dp"
            android:text="@{viewModel.entity.bqgjsxm}"
            android:layout_weight="2"
            android:layout_height="match_parent"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_6"
            />-->
        <!--
         android:ellipsize="middle"
            android:singleLine="true"
            android:maxEms="5"
            -->
        <TextView
            android:text="@{StringUtil.ellipsize(viewModel.entity.qrCode)}"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="2"
            android:layout_height="match_parent"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_6" />
        <TextView

            android:gravity="center"
            android:text="@{viewModel.entity.wasteName}"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_6"
            />
        <TextView

            android:text="@{String.valueOf(viewModel.entity.weight)}"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_6"
            />
        <TextView

            android:text="@{String.valueOf(viewModel.entity.createdAt)}"
            android:gravity="center"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="match_parent"
            android:textColor="#ffffffff"
            android:textSize="@dimen/sp_6"
            />
    </LinearLayout>
</layout>