<?xml version="1.0" encoding="utf-8"?>

<layout xmlns:android="http://schemas.android.com/apk/res/android">

    <data>
        <import type="com.xinchen.allInOne.utils.TypeUtils"/>
        <import type="me.xinchen.mvvmhabit.binding.viewadapter.recyclerview.LayoutManagers" />
        <variable
            name="viewModel"
            type="com.xinchen.allInOne.ui.outStorageManage.OutStorageDetailViewModel" />

    </data>

    <LinearLayout
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="match_parent">
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:background="@mipmap/label_from_top"
            android:orientation="horizontal">

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="出库批次号"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text=""
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="出库时间"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.createdAt}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>
        <LinearLayout

            android:layout_width="match_parent"
            android:background="@mipmap/label_from_center"
            android:layout_height="@dimen/dp_20dp"
            android:orientation="horizontal">

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="产废单位名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.cfName}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />


            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="出库类型"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.chukuType}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>
        <LinearLayout

            android:layout_width="match_parent"
            android:background="@mipmap/label_from_center"
            android:layout_height="@dimen/dp_20dp"
            android:orientation="horizontal">

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.wasteName}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />


            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="废物代码"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.wasteCode}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>
        <LinearLayout

            android:layout_width="match_parent"
            android:background="@mipmap/label_from_center"
            android:layout_height="@dimen/dp_20dp"
            android:orientation="horizontal">

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="出库重量(Kg)"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.weight}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />


            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="出库数量"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{String.valueOf(viewModel.Entity.qty)}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:background="@mipmap/label_from_center"
            android:orientation="horizontal">

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="利用处置设施名称"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.sheshiName}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="利用处置设施类型"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{TypeUtils.ChuZhiType(viewModel.Entity.type)}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />
        </LinearLayout>



        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="@dimen/dp_20dp"
            android:background="@mipmap/label_from_bottom"
            android:orientation="horizontal">
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="利用处置方式"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.useOrDisposalMethod}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />
            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="match_parent"
                android:text="操作人"
                android:textColor="#ffffffff"
                android:textSize="@dimen/sp_8" />

            <TextView
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_weight="2"
                android:layout_height="match_parent"
                android:text="@{viewModel.Entity.userName}"
                android:textColor="#9CA7BF"
                android:textSize="@dimen/sp_8" />


        </LinearLayout>
    </LinearLayout>
</layout>